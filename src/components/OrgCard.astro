---
import TrustBadge from './TrustBadge.astro';
import { parseCategories } from '../lib/search';
import type { OrgSearchRow } from '../lib/search';

interface Props {
  org: OrgSearchRow;
  opportunityCount?: number;
}

const { org, opportunityCount } = Astro.props;
const categories = parseCategories(org.categories);
const snippet = org.description
  ? org.description.slice(0, 120) + (org.description.length > 120 ? '…' : '')
  : org.mission?.slice(0, 120) ?? '';
---

<a
  href={`/orgs/${org.slug}`}
  class="group flex flex-col gap-4 rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)] transition-all hover:-translate-y-0.5 hover:border-(--leaf) hover:shadow-[var(--shadow-lg)]"
>
  <div class="flex items-start justify-between gap-3">
    <h2 class="text-base font-semibold text-(--forest) group-hover:text-(--forest-mid) transition-colors leading-snug">
      {org.name}
    </h2>
    <TrustBadge score={org.reputability_cached} />
  </div>

  {snippet && (
    <p class="text-sm text-(--text-muted) leading-relaxed line-clamp-2">{snippet}</p>
  )}

  <div class="flex flex-wrap items-center gap-2 mt-auto">
    {categories.slice(0, 3).map((cat) => (
      <span class="rounded-full bg-(--cream) border border-(--border) px-2.5 py-0.5 text-[11px] font-medium text-(--forest-light) capitalize">
        {cat.replace(/_/g, ' ')}
      </span>
    ))}
    {opportunityCount != null && (
      <span class="ml-auto text-xs text-(--text-muted)">
        {opportunityCount} {opportunityCount === 1 ? 'opportunity' : 'opportunities'}
      </span>
    )}
  </div>
</a>
