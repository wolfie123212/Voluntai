---
import { trustTier, TRUST_TIER_LABEL } from '../lib/score';

interface Props {
  score: number | null | undefined;
  showLabel?: boolean;
}

const { score, showLabel = true } = Astro.props;
const tier = trustTier(score);

const styles: Record<string, string> = {
  'highly-trusted': 'bg-green-400 text-green-950',
  'trusted': 'bg-green-600 text-white',
  'verified': 'bg-green-800 text-green-200',
  'listed': '',
};

const style = styles[tier];
---

{tier !== 'listed' && (
  <span class={`inline-flex items-center gap-1 rounded-full px-3 py-0.5 text-xs font-semibold tracking-wide ${style}`}>
    {tier === 'highly-trusted' || tier === 'trusted' ? (
      <svg class="h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
        <path d="M6 0L7.5 4.5H12L8.25 7.5L9.75 12L6 9L2.25 12L3.75 7.5L0 4.5H4.5Z"/>
      </svg>
    ) : (
      <svg class="h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 1.414l-6 6a1 1 0 01-1.414 0l-3-3a1 1 0 111.414-1.414L5 8.586l5.293-5.293z" clip-rule="evenodd"/>
      </svg>
    )}
    {showLabel && TRUST_TIER_LABEL[tier]}
  </span>
)}
