---
// Option C — Dusk / Night (pixel art, stars, crescent moon, amber windows)
---
<svg viewBox="0 0 1440 560" xmlns="http://www.w3.org/2000/svg"
  preserveAspectRatio="xMidYMid slice"
  style="shape-rendering:crispEdges;image-rendering:pixelated"
  class="w-full h-full" aria-hidden="true">
  <defs>
    <style>
      .cc1{animation:dc1 36s ease-in-out infinite alternate}
      .cc2{animation:dc2 48s ease-in-out infinite alternate-reverse}
      .swc1{transform-box:fill-box;transform-origin:bottom center;animation:swc 5s ease-in-out infinite alternate}
      .swc2{transform-box:fill-box;transform-origin:bottom center;animation:swc 6.5s ease-in-out infinite alternate-reverse}
      .swc3{transform-box:fill-box;transform-origin:bottom center;animation:swc 4.2s ease-in-out infinite alternate}
      .swc4{transform-box:fill-box;transform-origin:bottom center;animation:swc 5.4s ease-in-out infinite alternate-reverse}
      .swc5{transform-box:fill-box;transform-origin:bottom center;animation:swc 6.2s ease-in-out infinite alternate}
      .swc6{transform-box:fill-box;transform-origin:bottom center;animation:swc 4.6s ease-in-out infinite alternate-reverse}
      @keyframes dc1{from{transform:translateX(-12px)}to{transform:translateX(16px)}}
      @keyframes dc2{from{transform:translateX(10px)}to{transform:translateX(-20px)}}
      @keyframes swc{from{transform:rotate(-1deg)}to{transform:rotate(1deg)}}
    </style>
  </defs>

