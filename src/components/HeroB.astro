---
// Option B — Morning Fresh (pixel art, animated breeze)
---
<svg viewBox="0 0 1440 560" xmlns="http://www.w3.org/2000/svg"
  preserveAspectRatio="xMidYMid slice"
  style="shape-rendering:crispEdges;image-rendering:pixelated"
  class="w-full h-full" aria-hidden="true">
  <defs>
    <style>
      .cb1{animation:db1 28s ease-in-out infinite alternate}
      .cb2{animation:db2 38s ease-in-out infinite alternate-reverse}
      .cb3{animation:db3 22s ease-in-out infinite alternate}
      .swb1{transform-box:fill-box;transform-origin:bottom center;animation:sw 4s ease-in-out infinite alternate}
      .swb2{transform-box:fill-box;transform-origin:bottom center;animation:sw 5.5s ease-in-out infinite alternate-reverse}
      .swb3{transform-box:fill-box;transform-origin:bottom center;animation:sw 3.5s ease-in-out infinite alternate}
      .swb4{transform-box:fill-box;transform-origin:bottom center;animation:sw 4.2s ease-in-out infinite alternate-reverse}
      .swb5{transform-box:fill-box;transform-origin:bottom center;animation:sw 5.2s ease-in-out infinite alternate}
      .swb6{transform-box:fill-box;transform-origin:bottom center;animation:sw 3.7s ease-in-out infinite alternate-reverse}
      @keyframes db1{from{transform:translateX(-20px)}to{transform:translateX(20px)}}
      @keyframes db2{from{transform:translateX(16px)}to{transform:translateX(-28px)}}
      @keyframes db3{from{transform:translateX(-8px)}to{transform:translateX(36px)}}
      @keyframes sw{from{transform:rotate(-1.5deg)}to{transform:rotate(1.5deg)}}
    </style>
  </defs>

  <!-- SKY -->
  <rect width="1440" height="560" fill="#1E6FA8"/>
  <rect y="96"  width="1440" height="128" fill="#3D94C8"/>
  <rect y="224" width="1440" height="96"  fill="#7CC4E0"/>
  <rect y="320" width="1440" height="48"  fill="#BAE0F0"/>

  <!-- SUN -->
  <rect x="256" y="64"  width="96"  height="16" fill="#FFF870"/>
  <rect x="240" y="80"  width="128" height="16" fill="#FFF870"/>
  <rect x="240" y="96"  width="128" height="16" fill="#FFF870"/>
  <rect x="240" y="112" width="128" height="16" fill="#FFF870"/>
  <rect x="256" y="128" width="96"  height="16" fill="#FFF870"/>
  <rect x="208" y="64"  width="192" height="96" fill="#FFF870" opacity=".12"/>

  <!-- CLOUD 1 -->
