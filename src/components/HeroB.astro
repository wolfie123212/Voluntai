    <rect x="928"  y="112" width="144" height="16" fill="white" opacity=".9"/>
    <rect x="944"  y="128" width="112" height="16" fill="white" opacity=".9"/>
    <rect x="960"  y="144" width="64"  height="16" fill="white" opacity=".9"/>
