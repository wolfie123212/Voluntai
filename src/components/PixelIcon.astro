const { name, size = 24, class: className } = Astro.props;
const sprite = SPRITES[name];

// Merge horizontal runs of the same color into one rect each.
const rects: { x: number; y: number; w: number; fill: string }[] = [];
sprite.rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const ch = row[x];
    let w = 1;
    while (row[x + w] === ch) w++;
    if (ch !== '.' && sprite.colors[ch]) rects.push({ x, y, w, fill: sprite.colors[ch] });
    x += w;
  }
});
---

<svg
  viewBox="0 0 16 16"
  width={size}
  height={size}
  class={className}
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}
</svg>
