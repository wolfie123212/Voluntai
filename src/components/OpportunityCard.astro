---
import type { OpportunityRow } from '../lib/search';
import { parseCategories } from '../lib/search';

interface Props {
  opp: OpportunityRow;
}

const { opp } = Astro.props;
const categories = parseCategories(opp.categories);
---

<div class="rounded-2xl border border-(--border) bg-white p-5 shadow-[var(--shadow)]">
  <div class="flex items-start justify-between gap-3 flex-wrap mb-1">
    <h3 class="font-semibold text-(--forest)">
      <a href={`/opp/${opp.id}`} class="hover:text-(--forest-mid) transition-colors hover:underline underline-offset-2">
        {opp.title}
      </a>
    </h3>
    {opp.is_remote ? (
      <span class="rounded-full bg-(--cream) border border-(--border) px-2.5 py-0.5 text-[11px] font-medium text-(--forest-light)">Remote</span>
    ) : opp.in_person_address ? (
      <span class="rounded-full bg-(--cream) border border-(--border) px-2.5 py-0.5 text-[11px] font-medium text-(--forest-light)">In-person</span>
    ) : null}
  </div>

  {opp.summary && (
    <p class="mt-1.5 text-sm text-(--text-muted) leading-relaxed">{opp.summary}</p>
  )}

  <div class="mt-3 flex flex-wrap items-center gap-2.5 text-xs text-(--text-muted)">
    {opp.commitment && (
      <span class="flex items-center gap-1">
        <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        {opp.commitment}
      </span>
    )}
    {opp.hours_per_week && (
      <span class="flex items-center gap-1">
        <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        {opp.hours_per_week}h/week
      </span>
    )}
    {opp.min_age && <span>Ages {opp.min_age}+</span>}
    {categories.slice(0, 2).map((cat) => (
      <span class="rounded-full bg-(--cream) border border-(--border) px-2 py-0.5 capitalize">
        {cat.replace(/_/g, ' ')}
      </span>
    ))}
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2">
    {opp.signup_url && (
      <a
        href={opp.signup_url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full bg-(--forest) px-4 py-2 text-sm font-medium text-white hover:bg-(--forest-mid) transition-colors"
      >
        Sign up directly
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    )}
    <a
      href={`/opp/${opp.id}`}
      class="inline-flex items-center gap-1 rounded-full border border-(--border) bg-white px-4 py-2 text-sm font-medium text-(--forest-light) hover:border-(--leaf) hover:text-(--forest) transition-colors"
    >
      Details
    </a>
  </div>
</div>
