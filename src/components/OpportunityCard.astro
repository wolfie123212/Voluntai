---
import type { OpportunityRow } from '../lib/search';
import { parseCategories } from '../lib/search';

interface Props {
  opp: OpportunityRow;
}

const { opp } = Astro.props;
const categories = parseCategories(opp.categories);
---

<div class="rounded-xl border border-green-800/40 bg-green-950/60 p-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <h3 class="font-semibold text-white">{opp.title}</h3>
    {opp.is_remote ? (
      <span class="rounded-full bg-green-900 px-2.5 py-0.5 text-xs text-green-300">Remote</span>
    ) : opp.in_person_address ? (
      <span class="rounded-full bg-green-900 px-2.5 py-0.5 text-xs text-green-300">In-person</span>
    ) : null}
  </div>

  {opp.summary && (
    <p class="mt-2 text-sm text-green-300 leading-relaxed">{opp.summary}</p>
  )}

  <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-green-400">
    {opp.commitment && (
      <span class="flex items-center gap-1">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        {opp.commitment}
      </span>
    )}
    {opp.hours_per_week && (
      <span>{opp.hours_per_week}h/week</span>
    )}
    {opp.min_age && (
      <span>Ages {opp.min_age}+</span>
    )}
    {categories.slice(0, 2).map((cat) => (
      <span class="rounded-full bg-green-900 px-2 py-0.5 capitalize">{cat.replace(/_/g, ' ')}</span>
    ))}
  </div>

  {opp.signup_url && (
    <a
      href={opp.signup_url}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-500 transition-colors"
    >
      Sign up directly
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
    </a>
  )}
</div>
