  <rect x="1044" y="64"  width="160" height="16" fill="#FFD040"/>
  <rect x="1044" y="80"  width="160" height="16" fill="#FFD040"/>
  <rect x="1052" y="96"  width="144" height="16" fill="#FFD040"/>
  <rect x="1068" y="112" width="112" height="16" fill="#FFD040"/>
