---
// Option A — Golden Hour (pixel art, sunny afternoon, warm golden sky)
---
<svg viewBox="0 0 1440 560" xmlns="http://www.w3.org/2000/svg"
  preserveAspectRatio="xMidYMid slice"
  style="shape-rendering:crispEdges;image-rendering:pixelated"
  class="w-full h-full" aria-hidden="true">
  <defs>
    <style>
      .ca1{animation:da1 32s ease-in-out infinite alternate}
      .ca2{animation:da2 42s ease-in-out infinite alternate-reverse}
      .ca3{animation:da3 25s ease-in-out infinite alternate}
      .swa1{transform-box:fill-box;transform-origin:bottom center;animation:swa 4.2s ease-in-out infinite alternate}
      .swa2{transform-box:fill-box;transform-origin:bottom center;animation:swa 5.8s ease-in-out infinite alternate-reverse}
      .swa3{transform-box:fill-box;transform-origin:bottom center;animation:swa 3.6s ease-in-out infinite alternate}
      .swa4{transform-box:fill-box;transform-origin:bottom center;animation:swa 4.6s ease-in-out infinite alternate-reverse}
      .swa5{transform-box:fill-box;transform-origin:bottom center;animation:swa 5.4s ease-in-out infinite alternate}
      .swa6{transform-box:fill-box;transform-origin:bottom center;animation:swa 3.9s ease-in-out infinite alternate-reverse}
      @keyframes da1{from{transform:translateX(-18px)}to{transform:translateX(22px)}}
      @keyframes da2{from{transform:translateX(14px)}to{transform:translateX(-32px)}}
      @keyframes da3{from{transform:translateX(-10px)}to{transform:translateX(28px)}}
      @keyframes swa{from{transform:rotate(-1.5deg)}to{transform:rotate(1.5deg)}}
    </style>
  </defs>

  <!-- SKY — warm golden afternoon bands -->
