---
interface Props {
  q?: string;
  action?: string;
  large?: boolean;
}

const { q = '', action = '/search', large = false } = Astro.props;
---

<form action={action} method="get" role="search" class="w-full">
  <div class={`flex items-center gap-2 rounded-2xl bg-green-900 border border-green-700 focus-within:border-green-500 transition-colors ${large ? 'px-5 py-4' : 'px-4 py-2.5'}`}>
    <svg class={`shrink-0 text-green-400 ${large ? 'h-5 w-5' : 'h-4 w-4'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <input
      type="search"
      name="q"
      value={q}
      placeholder="Search by cause, skill, or organization…"
      autocomplete="off"
      class={`flex-1 bg-transparent text-white placeholder-green-500 outline-none ${large ? 'text-lg' : 'text-sm'}`}
      aria-label="Search volunteer opportunities"
    />
    <button
      type="submit"
      class={`shrink-0 rounded-xl bg-green-500 font-semibold text-green-950 hover:bg-green-400 transition-colors ${large ? 'px-6 py-2' : 'px-4 py-1.5 text-sm'}`}
    >
      Search
    </button>
  </div>
</form>
