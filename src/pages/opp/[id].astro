---
import Base from '../../layouts/Base.astro';
import { parseCategories } from '../../lib/search';
import type { OpportunityRow, OrgSearchRow } from '../../lib/search';

const { id } = Astro.params;
const oppId = Number(id);

if (!oppId || isNaN(oppId)) return Astro.redirect('/search');

interface OppDetailRow extends OpportunityRow {
  description: string | null;
  in_person_zip: string | null;
  expires_at: string | null;
  posted_at: string | null;
}

let opp: OppDetailRow | null = null;
let org: OrgSearchRow | null = null;

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    const oppResult = await db
      .prepare(`SELECT * FROM opportunities WHERE id = ? AND status = 'published' LIMIT 1`)
      .bind(oppId)
      .all<OppDetailRow>();
    opp = oppResult.results[0] ?? null;

    if (opp) {
      const orgResult = await db
        .prepare(`SELECT * FROM organizations WHERE id = ? AND status = 'published' LIMIT 1`)
        .bind(opp.org_id)
        .all<OrgSearchRow>();
      org = orgResult.results[0] ?? null;
    }
  }
} catch {
  // DB unavailable
}

if (!opp || !org) return Astro.redirect('/search');

const categories = parseCategories(opp.categories);
const isExpired = opp.expires_at ? new Date(opp.expires_at) < new Date() : false;
---

<Base
  title={`${opp.title} — ${org.name}`}
  description={opp.summary ?? `Volunteer opportunity at ${org.name} in NYC's East Village.`}
>
  <!-- ── BREADCRUMB ─────────────────────────────────────────────── -->
  <div class="bg-white border-b border-(--border)">
    <div class="mx-auto max-w-4xl px-4 py-4">
      <nav class="text-xs text-(--text-muted)" aria-label="Breadcrumb">
        <a href="/" class="hover:text-(--forest) transition-colors">Home</a>
        <span class="mx-1.5 opacity-40">›</span>
        <a href="/search" class="hover:text-(--forest) transition-colors">Find Opportunities</a>
        <span class="mx-1.5 opacity-40">›</span>
        <a href={`/orgs/${org.slug}`} class="hover:text-(--forest) transition-colors">{org.name}</a>
        <span class="mx-1.5 opacity-40">›</span>
        <span class="text-(--forest)">{opp.title}</span>
      </nav>
    </div>
  </div>

  <div class="bg-(--cream) min-h-screen">
    <div class="mx-auto max-w-4xl px-4 py-10">
      <div class="grid gap-6 lg:grid-cols-3">

        <!-- ── MAIN ──────────────────────────────────────────────── -->
        <div class="lg:col-span-2 space-y-6">

          <!-- Header card -->
          <div class="rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)]">
            {isExpired && (
              <p class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-amber-50 border border-amber-200 px-3 py-1 text-xs font-medium text-amber-700">
                ⚠️ This opportunity may have expired
              </p>
            )}

            <h1 class="text-2xl font-bold text-(--forest) sm:text-3xl leading-tight">{opp.title}</h1>
            <p class="mt-2 text-sm font-medium text-(--forest-light)">
              at{' '}
              <a href={`/orgs/${org.slug}`} class="underline underline-offset-2 hover:text-(--forest) transition-colors">
                {org.name}
              </a>
            </p>

            <!-- Meta chips -->
            <div class="mt-4 flex flex-wrap gap-2">
              {opp.is_remote ? (
                <span class="rounded-full bg-blue-50 border border-blue-200 px-3 py-1 text-xs font-medium text-blue-700">
                  🌐 Remote
                </span>
              ) : (
                <span class="rounded-full bg-(--cream) border border-(--border) px-3 py-1 text-xs font-medium text-(--forest-light)">
                  📍 In-person
                </span>
              )}
              {opp.commitment && (
                <span class="rounded-full bg-(--cream) border border-(--border) px-3 py-1 text-xs font-medium text-(--forest-light)">
                  🕐 {opp.commitment}
                </span>
              )}
              {opp.hours_per_week && (
                <span class="rounded-full bg-(--cream) border border-(--border) px-3 py-1 text-xs font-medium text-(--forest-light)">
                  {opp.hours_per_week}h/week
                </span>
              )}
              {opp.min_age && (
                <span class="rounded-full bg-(--cream) border border-(--border) px-3 py-1 text-xs font-medium text-(--forest-light)">
                  Ages {opp.min_age}+
                </span>
              )}
              {categories.map((cat) => (
                <a
                  href={`/search?q=${cat}`}
                  class="rounded-full bg-(--cream) border border-(--border) px-3 py-1 text-xs font-medium text-(--forest-light) capitalize hover:border-(--leaf) hover:text-(--forest) transition-colors"
                >
                  {cat.replace(/_/g, ' ')}
                </a>
              ))}
            </div>
          </div>

          <!-- Description -->
          {(opp.summary || opp.description) && (
            <section class="rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)]" aria-label="About this opportunity">
              <h2 class="mb-3 text-base font-semibold text-(--forest)">About this opportunity</h2>
              {opp.summary && (
                <p class="text-sm text-(--text-muted) leading-relaxed">{opp.summary}</p>
              )}
              {opp.description && opp.description !== opp.summary && (
                <p class="mt-3 text-sm text-(--text-muted) leading-relaxed">{opp.description}</p>
              )}
            </section>
          )}

          <!-- Schedule -->
          {opp.schedule && (
            <section class="rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)]" aria-label="Schedule">
              <h2 class="mb-3 text-base font-semibold text-(--forest)">Schedule</h2>
              <p class="text-sm text-(--text-muted) flex items-center gap-2">
                <svg class="h-4 w-4 shrink-0 text-(--forest-light)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                {opp.schedule}
              </p>
            </section>
          )}

          <!-- Location -->
          {!opp.is_remote && (opp.in_person_address || org.address_line1) && (
            <section class="rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)]" aria-label="Location">
              <h2 class="mb-3 text-base font-semibold text-(--forest)">Location</h2>
              <p class="text-sm text-(--text-muted) flex items-start gap-2">
                <svg class="h-4 w-4 shrink-0 mt-0.5 text-(--forest-light)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span>
                  {opp.in_person_address ?? org.address_line1}
                  {(opp.in_person_zip ?? org.zip) ? `, ${opp.in_person_zip ?? org.zip}` : ''}
                </span>
              </p>
            </section>
          )}

          <!-- Sign up CTA -->
          {opp.signup_url && !isExpired && (
            <div class="rounded-2xl border-2 border-(--forest) bg-white p-6 shadow-[var(--shadow)] text-center">
              <p class="mb-4 text-(--text-muted) text-sm">
                Ready to volunteer? Sign up directly with {org.name} — no middleman.
              </p>
              <a
                href={opp.signup_url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full bg-(--forest) px-6 py-3 text-base font-semibold text-white hover:bg-(--forest-mid) transition-colors shadow-sm"
              >
                Sign up directly
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
          )}
          {isExpired && opp.signup_url && (
            <div class="rounded-2xl border border-(--border) bg-white p-6 text-center">
              <p class="text-(--text-muted) text-sm mb-3">This opportunity may have expired. Check the organization's website for current listings.</p>
              <a
                href={org.website ?? opp.signup_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-(--forest-light) underline underline-offset-2 hover:text-(--forest) transition-colors"
              >
                Visit {org.name}'s website →
              </a>
            </div>
          )}

        </div>

        <!-- ── SIDEBAR ────────────────────────────────────────────── -->
        <aside class="space-y-4" aria-label="Organization info">

          <!-- Org summary card -->
          <div class="rounded-2xl border border-(--border) bg-white p-5 shadow-[var(--shadow)]">
            <h3 class="mb-1 text-sm font-semibold text-(--forest)">{org.name}</h3>
            {org.neighborhood && (
              <p class="text-xs text-(--text-muted) flex items-center gap-1 mb-3">
                <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                {org.neighborhood}
              </p>
            )}
            {org.mission && (
              <p class="text-xs text-(--text-muted) leading-relaxed line-clamp-3">{org.mission}</p>
            )}
            <a
              href={`/orgs/${org.slug}`}
              class="mt-4 flex items-center gap-1 text-xs font-medium text-(--forest-light) hover:text-(--forest) transition-colors"
            >
              View all opportunities →
            </a>
          </div>

          <!-- Trust badges -->
          {(org.is_irs_501c3 || org.admin_verified_by || org.is_americorps_grantee || org.charity_nav_stars) && (
            <div class="rounded-2xl border border-(--border) bg-white p-5 shadow-[var(--shadow)]">
              <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-(--text-muted)">
                Verified organization
              </h3>
              <ul class="space-y-2.5">
                {org.is_irs_501c3 === 1 && (
                  <li class="flex items-center gap-2 text-xs text-(--forest)">
                    <span aria-hidden="true">🏛️</span> IRS 501(c)(3) nonprofit
                  </li>
                )}
                {org.admin_verified_by && (
                  <li class="flex items-center gap-2 text-xs text-(--forest)">
                    <span aria-hidden="true">🎓</span> Staff-verified
                  </li>
                )}
                {org.is_americorps_grantee === 1 && (
                  <li class="flex items-center gap-2 text-xs text-(--forest)">
                    <span aria-hidden="true">🇺🇸</span> AmeriCorps grantee
                  </li>
                )}
                {org.charity_nav_stars && (
                  <li class="flex items-center gap-2 text-xs text-(--forest)">
                    <span aria-hidden="true">⭐</span> {org.charity_nav_stars}-star Charity Navigator
                  </li>
                )}
              </ul>
              <a href="/verification" class="mt-3 block text-xs text-(--text-muted) hover:text-(--forest) transition-colors">
                What do these mean? →
              </a>
            </div>
          )}

          <!-- Contact -->
          {(org.website || org.email) && (
            <div class="rounded-2xl border border-(--border) bg-white p-5 shadow-[var(--shadow)]">
              <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-(--text-muted)">
                Contact
              </h3>
              <div class="space-y-2.5">
                {org.website && (
                  <a
                    href={org.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 text-xs text-(--forest-light) hover:text-(--forest) transition-colors break-all"
                  >
                    <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                    </svg>
                    {org.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                  </a>
                )}
                {org.email && (
                  <a
                    href={`mailto:${org.email}`}
                    class="flex items-center gap-2 text-xs text-(--forest-light) hover:text-(--forest) transition-colors break-all"
                  >
                    <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    {org.email}
                  </a>
                )}
              </div>
            </div>
          )}

          <!-- Report link -->
          <p class="text-center text-xs text-(--text-muted)">
            Something wrong?
            <a href={`/contact?type=takedown&org=${org.slug}`} class="underline hover:text-(--forest) transition-colors">
              Report this listing
            </a>
          </p>
        </aside>

      </div>
    </div>
  </div>
</Base>
