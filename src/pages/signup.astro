---
import Base from '../layouts/Base.astro';
import { createAuth } from '../lib/auth';
import { verifyTurnstile } from '../lib/turnstile';

const env = Astro.locals.runtime?.env;
const siteKey = env?.TURNSTILE_SITE_KEY ?? import.meta.env.TURNSTILE_SITE_KEY ?? '';

// Redirect if already signed in
if (env) {
  const auth = createAuth(env);
  const session = await auth.api.getSession({ headers: Astro.request.headers });
  if (session?.user) return Astro.redirect('/account');
}

let error = '';
let success = false;

if (Astro.request.method === 'POST' && env) {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');
  const name = String(form.get('name') ?? '').trim();
  const yearOfBirth = parseInt(String(form.get('year_of_birth') ?? '0'));
  const agreeToTerms = form.get('agree_to_terms');
  const turnstileToken = String(form.get('cf-turnstile-response') ?? '');

  // Validate age — must be >= 16
  const age = new Date().getFullYear() - yearOfBirth;
  if (!yearOfBirth || yearOfBirth < 1900 || yearOfBirth > new Date().getFullYear()) {
    error = 'Please enter a valid year of birth.';
  } else if (age < 16) {
    error = 'You must be at least 16 to create an account. You can still browse opportunities without an account.';
  } else if (!agreeToTerms) {
    error = 'You must agree to the Terms and Privacy Policy to continue.';
  } else if (!email || !password || !name) {
    error = 'All fields are required.';
  } else if (password.length < 8) {
    error = 'Password must be at least 8 characters.';
  } else {
    // Verify Turnstile
    const turnstileOk = await verifyTurnstile(turnstileToken, env.TURNSTILE_SECRET_KEY);
    if (!turnstileOk) {
      error = 'CAPTCHA verification failed. Please try again.';
    } else {
      // Create account via Better Auth
      const auth = createAuth(env);
      const authReq = new Request(`${env.APP_BASE_URL}/api/auth/sign-up/email`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, name }),
      });

      const authRes = await auth.handler(authReq);

      if (authRes.ok) {
        // Store year of birth on the user row
        await env.DB
          .prepare('UPDATE users SET age_declared = ? WHERE email = ?')
          .bind(yearOfBirth, email)
          .run();
        success = true;
      } else {
        const body = await authRes.json() as { message?: string };
        error = body.message ?? 'Signup failed. That email may already be registered.';
      }
    }
  }
}
---

<Base title="Create Account">
  <div class="min-h-[80vh] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">

      {success ? (
        <!-- Success state -->
        <div class="rounded-2xl border border-(--border) bg-white p-10 shadow-[var(--shadow)] text-center">
          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-(--cream)">
            <span class="text-4xl" aria-hidden="true">📬</span>
          </div>
          <h1 class="mb-3 text-2xl font-bold text-(--forest)">Check your inbox</h1>
          <p class="text-(--text-muted) leading-relaxed">
            We've sent a verification link to your email. Click it to activate your account and start leaving reviews.
          </p>
          <a href="/search" class="mt-8 inline-flex items-center gap-1.5 rounded-xl bg-(--forest) px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-(--forest-mid) transition-colors">
            Browse opportunities
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
          </a>
        </div>
      ) : (
        <>
          <!-- Header -->
          <div class="mb-8 text-center">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-(--forest) shadow-lg">
              <svg class="h-6 w-6 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z" />
              </svg>
            </div>
            <h1 class="text-2xl font-bold text-(--forest)">Create your account</h1>
            <p class="mt-1.5 text-sm text-(--text-muted)">
              Already have one?
              <a href="/signin" class="font-medium text-(--forest-light) underline underline-offset-2 hover:text-(--forest) transition-colors">Sign in</a>
            </p>
          </div>

          <!-- Card -->
          <div class="rounded-2xl border border-(--border) bg-white p-8 shadow-[var(--shadow)]">

            {error && (
              <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert" aria-live="polite">
                <div class="flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                  </svg>
                  <span>{error}</span>
                </div>
              </div>
            )}

            <form method="post" class="space-y-5" novalidate>
              <div>
                <label for="name" class="mb-1.5 block text-sm font-medium text-(--forest)">Display name</label>
                <input id="name" name="name" type="text" required autocomplete="name"
                  class="w-full rounded-xl border border-(--border) bg-(--cream) px-4 py-2.5 text-(--forest) placeholder-(--text-muted)/60 focus:border-(--leaf) focus:outline-none focus:ring-2 focus:ring-(--leaf)/20 transition-all"
                  placeholder="Your name" />
              </div>
              <div>
                <label for="email" class="mb-1.5 block text-sm font-medium text-(--forest)">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email"
                  class="w-full rounded-xl border border-(--border) bg-(--cream) px-4 py-2.5 text-(--forest) placeholder-(--text-muted)/60 focus:border-(--leaf) focus:outline-none focus:ring-2 focus:ring-(--leaf)/20 transition-all"
                  placeholder="you@example.com" />
              </div>
              <div>
                <label for="password" class="mb-1.5 block text-sm font-medium text-(--forest)">Password</label>
                <input id="password" name="password" type="password" required autocomplete="new-password" minlength="8"
                  class="w-full rounded-xl border border-(--border) bg-(--cream) px-4 py-2.5 text-(--forest) placeholder-(--text-muted)/60 focus:border-(--leaf) focus:outline-none focus:ring-2 focus:ring-(--leaf)/20 transition-all"
                  placeholder="At least 8 characters" />
              </div>
              <div>
                <label for="year_of_birth" class="mb-1.5 block text-sm font-medium text-(--forest)">
                  Year of birth <span class="font-normal text-(--text-muted)">(must be 16+)</span>
                </label>
                <input id="year_of_birth" name="year_of_birth" type="number" required
                  min="1900" max={new Date().getFullYear() - 16}
                  class="w-full rounded-xl border border-(--border) bg-(--cream) px-4 py-2.5 text-(--forest) placeholder-(--text-muted)/60 focus:border-(--leaf) focus:outline-none focus:ring-2 focus:ring-(--leaf)/20 transition-all"
                  placeholder="e.g. 2001" />
              </div>

              <!-- Turnstile widget -->
              <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>

              <!-- Clickwrap — required per BUILD_PLAN §10.2 -->
              <div class="flex items-start gap-3">
                <input id="agree_to_terms" name="agree_to_terms" type="checkbox" value="yes" required
                  class="mt-0.5 h-4 w-4 shrink-0 rounded border-(--border) bg-(--cream) accent-(--forest)" />
                <label for="agree_to_terms" class="text-sm text-(--text-muted) leading-relaxed">
                  I have read and agree to the
                  <a href="/terms" class="font-medium text-(--forest-light) underline underline-offset-2 hover:text-(--forest)">Terms</a>
                  and
                  <a href="/privacy" class="font-medium text-(--forest-light) underline underline-offset-2 hover:text-(--forest)">Privacy Policy</a>.
                  I am at least 16 years old.
                </label>
              </div>

              <button type="submit" class="w-full rounded-xl bg-(--forest) py-3 font-semibold text-white shadow-sm hover:bg-(--forest-mid) transition-colors focus:outline-none focus:ring-2 focus:ring-(--forest) focus:ring-offset-2">
                Create account
              </button>
            </form>

            <!-- Divider -->
            <div class="my-6 flex items-center gap-3">
              <div class="flex-1 border-t border-(--border)"></div>
              <span class="text-xs font-medium text-(--text-muted)">or</span>
              <div class="flex-1 border-t border-(--border)"></div>
            </div>

            <!-- Google OAuth — client-side fetch so the browser stores the state cookie -->
            <button id="google-signup-btn" type="button" class="flex w-full items-center justify-center gap-3 rounded-xl border border-(--border) bg-white py-3 text-sm font-medium text-(--forest) shadow-sm hover:bg-(--cream) hover:border-(--forest-light)/30 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
              <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
              <span id="google-signup-label">Sign up with Google</span>
            </button>
            <p id="google-signup-err" class="mt-2 text-xs text-center text-red-600 hidden" aria-live="polite"></p>

            <script>
              document.getElementById('google-signup-btn')?.addEventListener('click', async () => {
                const btn = document.getElementById('google-signup-btn') as HTMLButtonElement | null;
                const label = document.getElementById('google-signup-label');
                const errEl = document.getElementById('google-signup-err');
                if (!btn || !label || !errEl) return;

                btn.disabled = true;
                label.textContent = 'Redirecting to Google…';
                errEl.classList.add('hidden');

                try {
                  const res = await fetch('/api/auth/sign-in/social', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ provider: 'google', callbackURL: '/account', errorCallbackURL: '/signin?error=oauth_callback', disableRedirect: true }),
                  });

                  const data = await res.json() as { url?: string; redirect?: string; message?: string };
                  const url = data.url ?? data.redirect;

                  if (url) {
                    window.location.href = url;
                    return;
                  }

                  errEl.textContent = data.message ?? 'Google sign-up failed. Please try again.';
                  errEl.classList.remove('hidden');
                } catch (err) {
                  errEl.textContent = 'Network error. Please check your connection and try again.';
                  errEl.classList.remove('hidden');
                }

                btn.disabled = false;
                label.textContent = 'Sign up with Google';
              });
            </script>
          </div>
        </>
      )}
    </div>
  </div>
</Base>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
