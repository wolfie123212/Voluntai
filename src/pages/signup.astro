---
import Base from '../layouts/Base.astro';
import { createAuth } from '../lib/auth';
import { verifyTurnstile } from '../lib/turnstile';

const env = Astro.locals.runtime?.env;
const siteKey = env?.TURNSTILE_SITE_KEY ?? import.meta.env.TURNSTILE_SITE_KEY ?? '';

// Redirect if already signed in
if (env) {
  const auth = createAuth(env);
  const session = await auth.api.getSession({ headers: Astro.request.headers });
  if (session?.user) return Astro.redirect('/account');
}

let error = '';
let success = false;

if (Astro.request.method === 'POST' && env) {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');
  const name = String(form.get('name') ?? '').trim();
  const yearOfBirth = parseInt(String(form.get('year_of_birth') ?? '0'));
  const agreeToTerms = form.get('agree_to_terms');
  const turnstileToken = String(form.get('cf-turnstile-response') ?? '');

  // Validate age — must be >= 16
  const age = new Date().getFullYear() - yearOfBirth;
  if (!yearOfBirth || yearOfBirth < 1900 || yearOfBirth > new Date().getFullYear()) {
    error = 'Please enter a valid year of birth.';
  } else if (age < 16) {
    error = 'You must be at least 16 to create an account. You can still browse opportunities without an account.';
  } else if (!agreeToTerms) {
    error = 'You must agree to the Terms and Privacy Policy to continue.';
  } else if (!email || !password || !name) {
    error = 'All fields are required.';
  } else if (password.length < 8) {
    error = 'Password must be at least 8 characters.';
  } else {
    // Verify Turnstile
    const turnstileOk = await verifyTurnstile(turnstileToken, env.TURNSTILE_SECRET_KEY);
    if (!turnstileOk) {
      error = 'CAPTCHA verification failed. Please try again.';
    } else {
      // Create account via Better Auth
      const auth = createAuth(env);
      const authReq = new Request(`${env.APP_BASE_URL}/api/auth/sign-up/email`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, name }),
      });

      const authRes = await auth.handler(authReq);

      if (authRes.ok) {
        // Store year of birth on the user row
        await env.DB
          .prepare('UPDATE users SET age_declared = ? WHERE email = ?')
          .bind(yearOfBirth, email)
          .run();
        success = true;
      } else {
        const body = await authRes.json() as { message?: string };
        error = body.message ?? 'Signup failed. That email may already be registered.';
      }
    }
  }
}
---

<Base title="Create Account">
  <div class="mx-auto max-w-md px-4 py-16">
    <div class="rounded-2xl border border-green-800/50 bg-green-900/30 p-8">

      {success ? (
        <div class="text-center">
          <div class="mb-4 text-5xl" aria-hidden="true">📬</div>
          <h1 class="mb-3 text-2xl font-bold text-white">Check your inbox</h1>
          <p class="text-green-300">
            We've sent a verification link to your email. Click it to activate your account and start leaving reviews.
          </p>
          <a href="/search" class="mt-8 inline-block rounded-xl bg-green-800 px-6 py-3 text-sm font-medium text-white hover:bg-green-700 transition-colors">
            Browse opportunities →
          </a>
        </div>
      ) : (
        <>
          <h1 class="mb-2 text-2xl font-bold text-white">Create account</h1>
          <p class="mb-8 text-sm text-green-400">
            Already have one? <a href="/signin" class="text-green-300 underline underline-offset-2 hover:text-white">Sign in</a>
          </p>

          {error && (
            <div class="mb-6 rounded-xl border border-red-800/50 bg-red-900/30 px-4 py-3 text-sm text-red-300" role="alert" aria-live="polite">
              {error}
            </div>
          )}

          <form method="post" class="space-y-4" novalidate>
            <div>
              <label for="name" class="mb-1.5 block text-sm font-medium text-green-300">Display name</label>
              <input id="name" name="name" type="text" required autocomplete="name"
                class="w-full rounded-xl border border-green-700 bg-green-900/50 px-4 py-2.5 text-white placeholder-green-600 focus:border-green-500 focus:outline-none"
                placeholder="Your name" />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-green-300">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email"
                class="w-full rounded-xl border border-green-700 bg-green-900/50 px-4 py-2.5 text-white placeholder-green-600 focus:border-green-500 focus:outline-none"
                placeholder="you@example.com" />
            </div>
            <div>
              <label for="password" class="mb-1.5 block text-sm font-medium text-green-300">Password</label>
              <input id="password" name="password" type="password" required autocomplete="new-password" minlength="8"
                class="w-full rounded-xl border border-green-700 bg-green-900/50 px-4 py-2.5 text-white placeholder-green-600 focus:border-green-500 focus:outline-none"
                placeholder="At least 8 characters" />
            </div>
            <div>
              <label for="year_of_birth" class="mb-1.5 block text-sm font-medium text-green-300">
                Year of birth <span class="font-normal text-green-500">(must be 16+)</span>
              </label>
              <input id="year_of_birth" name="year_of_birth" type="number" required
                min="1900" max={new Date().getFullYear() - 16}
                class="w-full rounded-xl border border-green-700 bg-green-900/50 px-4 py-2.5 text-white placeholder-green-600 focus:border-green-500 focus:outline-none"
                placeholder="e.g. 2001" />
            </div>

            <!-- Turnstile widget -->
            <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark"></div>

            <!-- Clickwrap — required per BUILD_PLAN §10.2 -->
            <div class="flex items-start gap-3">
              <input id="agree_to_terms" name="agree_to_terms" type="checkbox" value="yes" required
                class="mt-0.5 h-4 w-4 shrink-0 rounded border-green-700 bg-green-900 accent-green-500" />
              <label for="agree_to_terms" class="text-sm text-green-300">
                I have read and agree to the
                <a href="/terms" class="text-green-400 underline underline-offset-2 hover:text-white">Terms</a>
                and
                <a href="/privacy" class="text-green-400 underline underline-offset-2 hover:text-white">Privacy Policy</a>.
                I am at least 16 years old.
              </label>
            </div>

            <button type="submit" class="w-full rounded-xl bg-green-500 py-3 font-semibold text-green-950 hover:bg-green-400 transition-colors">
              Create account
            </button>
          </form>

          <div class="my-6 flex items-center gap-3">
            <div class="flex-1 border-t border-green-800"></div>
            <span class="text-xs text-green-600">or</span>
            <div class="flex-1 border-t border-green-800"></div>
          </div>

          <a href="/api/auth/sign-in/social?provider=google"
            class="flex w-full items-center justify-center gap-3 rounded-xl border border-green-700 bg-green-900/30 py-3 text-sm font-medium text-white hover:bg-green-900/60 transition-colors">
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Sign up with Google
          </a>
        </>
      )}
    </div>
  </div>
</Base>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
