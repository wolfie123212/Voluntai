---
import Base from '../layouts/Base.astro';
import HeroA from '../components/HeroA.astro';
import HeroB from '../components/HeroB.astro';
import HeroC from '../components/HeroC.astro';
import OrgCard from '../components/OrgCard.astro';
import type { OrgSearchRow } from '../lib/search';

// Time-based hero — server-side NYC timezone, no client JS needed
const nyHour = parseInt(
  new Date().toLocaleString('en-US', {
    timeZone: 'America/New_York',
    hour: 'numeric',
    hour12: false,
  })
);
// Morning 6–11: HeroB (bright blue sky)
// Day 11–19: HeroA (golden hour glow)
// Night 19–6: HeroC (dusk / stars)
const heroVariant: 'A' | 'B' | 'C' =
  nyHour >= 6 && nyHour < 11 ? 'B' : nyHour >= 11 && nyHour < 19 ? 'A' : 'C';

let featuredOrgs: OrgSearchRow[] = [];
let totalOrgs = 69;
try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    const result = await db
      .prepare(`SELECT * FROM organizations WHERE status = 'published' ORDER BY reputability_cached DESC LIMIT 6`)
      .all<OrgSearchRow>();
    featuredOrgs = result.results;
    const countRow = await db
      .prepare(`SELECT COUNT(*) as n FROM organizations WHERE status = 'published'`)
      .first<{ n: number }>();
    totalOrgs = countRow?.n ?? 69;
  }
} catch {
  // DB unavailable in local dev without wrangler
}

const CATEGORIES = [
  { label: 'Food & Hunger',  icon: '🍽️', q: 'food',    color: 'bg-orange-50 border-orange-200 hover:border-orange-400 text-orange-700' },
  { label: 'Seniors',        icon: '🤝', q: 'seniors', color: 'bg-blue-50 border-blue-200 hover:border-blue-400 text-blue-700' },
  { label: 'Youth',          icon: '🎓', q: 'youth',   color: 'bg-purple-50 border-purple-200 hover:border-purple-400 text-purple-700' },
  { label: 'Housing',        icon: '🏠', q: 'housing', color: 'bg-amber-50 border-amber-200 hover:border-amber-400 text-amber-700' },
  { label: 'Animals',        icon: '🐾', q: 'animals', color: 'bg-green-50 border-green-200 hover:border-green-400 text-green-700' },
  { label: 'Health',         icon: '💚', q: 'health',  color: 'bg-teal-50 border-teal-200 hover:border-teal-400 text-teal-700' },
  { label: 'Environment',    icon: '🌱', q: 'environment', color: 'bg-lime-50 border-lime-200 hover:border-lime-400 text-lime-700' },
  { label: 'Arts & Culture', icon: '🎨', q: 'arts',    color: 'bg-rose-50 border-rose-200 hover:border-rose-400 text-rose-700' },
];

const STEPS = [
  {
    number: '01',
    icon: '🔍',
    title: 'Search',
    body: 'Browse by cause, neighborhood, or schedule. Every listing is hand-verified.',
  },
  {
    number: '02',
    icon: '✅',
    title: 'Verify',
    body: 'Check IRS status, community reviews, and our reputability score — all in one place.',
  },
  {
    number: '03',
    icon: '🤝',
    title: 'Show up',
    body: "Hit the org's own signup page directly. No middlemen, no waitlists, no apps.",
  },
];
---

<Base title="Home" heroNav={true}>

  <!-- ── HERO ─────────────────────────────────────────────────────── -->
  <section class="relative min-h-[78vh] flex flex-col justify-center overflow-hidden -mt-14" aria-label="Hero">

    <!-- Illustrated background (time-based) -->
    <div class="absolute inset-0 w-full h-full" aria-hidden="true">
      {heroVariant === 'A' && <HeroA />}
      {heroVariant === 'B' && <HeroB />}
      {heroVariant === 'C' && <HeroC />}
    </div>

    <!-- Gradient overlays -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/15 to-black/5 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/15 to-transparent pointer-events-none" aria-hidden="true"></div>

    <!-- Content -->
    <div class="relative z-10 w-full px-6 sm:px-10 lg:px-20 pb-16 pt-28 sm:pt-32">
      <div class="max-w-[560px]">

        <!-- Location badge -->
        <span class="inline-flex items-center gap-1.5 rounded-full border border-white/30 bg-white/12 backdrop-blur-sm px-4 py-1.5 text-[11px] font-semibold tracking-widest text-white/90 mb-5 uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-green-400 inline-block animate-pulse"></span>
          East Village · LES · Chinatown · Tribeca · FiDi
        </span>

        <h1 class="text-[clamp(2.6rem,7vw,4.2rem)] font-extrabold leading-[1.0] tracking-tight text-white" style="text-shadow: 0 2px 32px rgba(0,0,0,0.45)">
          Serve your city.<br/>Find your cause.
        </h1>

        <p class="mt-5 text-[1.05rem] leading-relaxed text-white/85 max-w-[420px]" style="text-shadow: 0 1px 14px rgba(0,0,0,0.4)">
          Verified volunteer opportunities in NYC's East Village
          for the artists, athletes, students, and neighbors who want to give back.
        </p>

        <!-- Search -->
        <form action="/search" method="get" class="mt-7 flex w-full max-w-[480px] items-center gap-2 rounded-full border border-white/30 bg-white/15 backdrop-blur-md px-5 py-3 shadow-2xl" role="search" aria-label="Search volunteer opportunities">
          <svg class="h-4 w-4 shrink-0 text-white/60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/>
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Search by cause, org name, or neighborhood…"
            class="flex-1 bg-transparent text-[14px] text-white placeholder-white/50 outline-none min-w-0"
            aria-label="Keyword search"
          />
          <button
            type="submit"
            class="shrink-0 rounded-full bg-white px-5 py-2 text-[13px] font-semibold text-(--forest) transition-all hover:bg-white/90 hover:scale-105"
          >
            Find →
          </button>
        </form>

        <p class="mt-3 text-[11px] text-white/45 tracking-wide">
          Verified by IRS · ProPublica · Friends Seminary Service Office
        </p>

        <!-- Social proof -->
        <div class="mt-6 flex items-center gap-3 flex-wrap">
          <div class="inline-flex items-center gap-2.5 rounded-2xl border border-white/20 bg-black/20 backdrop-blur-sm px-4 py-2.5">
            <div class="flex -space-x-1.5">
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-(--forest)/90 text-[11px] font-bold text-white ring-1 ring-white/20">W</span>
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-(--forest-mid)/90 text-[11px] font-bold text-white ring-1 ring-white/20">A</span>
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-green-600/90 text-[11px] font-bold text-white ring-1 ring-white/20">J</span>
            </div>
            <p class="text-[12px] font-medium text-white/90">
              <span class="font-bold text-white">47 volunteers</span> signed up this month
            </p>
          </div>
          <div class="inline-flex items-center gap-1.5 rounded-2xl border border-white/20 bg-black/20 backdrop-blur-sm px-4 py-2.5">
            <span class="text-[13px]">🏛️</span>
            <p class="text-[12px] font-medium text-white/90">
              <span class="font-bold text-white">{totalOrgs}</span> verified nonprofits
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── STATS STRIP ─────────────────────────────────────────────── -->
  <section class="bg-white border-b border-(--border)" aria-label="Quick stats">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-2 sm:grid-cols-4 divide-x divide-(--border)">
        {[
          { num: String(totalOrgs),  label: 'verified organizations' },
          { num: '5',                label: 'NYC neighborhoods covered' },
          { num: '100%',             label: 'IRS-confirmed 501(c)(3)s' },
          { num: 'Free',             label: 'always, for everyone' },
        ].map(({ num, label }) => (
          <div class="flex flex-col items-center justify-center gap-0.5 py-5 px-4 text-center">
            <span class="text-2xl font-extrabold text-(--forest) tracking-tight">{num}</span>
            <span class="text-[11px] text-(--text-muted) leading-tight">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FEATURED ORGS ─────────────────────────────────────────── -->
  {featuredOrgs.length > 0 && (
    <section class="bg-(--cream) py-16 px-4" aria-label="Featured organizations">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex items-end justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Start here</p>
            <h2 class="text-2xl font-bold text-(--forest)">Top-rated organizations</h2>
            <p class="mt-1 text-sm text-(--text-muted)">Sorted by reputability score — updated nightly.</p>
          </div>
          <a href="/search" class="hidden sm:inline-flex items-center gap-1 text-sm font-medium text-(--forest-light) hover:text-(--forest) transition-colors">
            Browse all {totalOrgs}
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
          </a>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featuredOrgs.slice(0, 6).map((org) => (
            <OrgCard org={org} />
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/search" class="inline-flex items-center gap-2 rounded-full border border-(--border) bg-white px-6 py-3 text-sm font-semibold text-(--forest) shadow-[var(--shadow)] transition-all hover:-translate-y-0.5 hover:shadow-[var(--shadow-lg)] hover:border-(--leaf)">
            Explore all {totalOrgs} organizations →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── BROWSE BY CAUSE ────────────────────────────────────────── -->
  <section class="bg-white py-14 px-4" aria-label="Browse by category">
    <div class="mx-auto max-w-6xl">
      <div class="mb-8 text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">What moves you?</p>
        <h2 class="text-2xl font-bold text-(--forest)">Browse by cause</h2>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
        {CATEGORIES.map(({ label, icon, q, color }) => (
          <a
            href={`/search?q=${q}`}
            class={`group flex flex-col items-center gap-2 rounded-2xl border px-3 py-5 text-center transition-all hover:-translate-y-0.5 hover:shadow-md ${color}`}
          >
            <span class="text-2xl" aria-hidden="true">{icon}</span>
            <span class="text-[10px] font-semibold leading-tight transition-colors">{label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FOR STUDENTS ─────────────────────────────────────────── -->
  <section class="bg-(--forest) py-16 px-4" aria-label="For students">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16 items-center">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[11px] font-semibold tracking-widest text-green-300 uppercase mb-4">
            🎓 Students &amp; young volunteers
          </span>
          <h2 class="text-3xl font-extrabold text-white leading-tight mb-4">
            Service that fits<br/>your schedule and your identity.
          </h2>
          <p class="text-(--leaf-light) text-sm leading-relaxed mb-6">
            Whether you're a swimmer, a painter, a debate captain, or just someone who wants to do more —
            CityServ helps you find meaningful service that connects to who you actually are.
            No cold calls, no generic listings.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/search?q=youth" class="inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/20 px-4 py-2 text-sm font-medium text-white hover:bg-white/20 transition-colors">
              Youth programs
            </a>
            <a href="/search?q=arts" class="inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/20 px-4 py-2 text-sm font-medium text-white hover:bg-white/20 transition-colors">
              Arts &amp; culture
            </a>
            <a href="/search?q=tutoring" class="inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/20 px-4 py-2 text-sm font-medium text-white hover:bg-white/20 transition-colors">
              Tutoring
            </a>
            <a href="/search?q=environment" class="inline-flex items-center gap-1.5 rounded-full bg-white/10 border border-white/20 px-4 py-2 text-sm font-medium text-white hover:bg-white/20 transition-colors">
              Environment
            </a>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          {[
            { icon: '🎨', label: 'Artists', sub: 'Arts orgs, mural projects, community galleries' },
            { icon: '🏃', label: 'Athletes', sub: 'Youth sports coaching, adaptive fitness, rec centers' },
            { icon: '📚', label: 'Students', sub: 'Tutoring, literacy, after-school programs' },
            { icon: '🌿', label: 'Neighbors', sub: 'Block associations, park cleanups, food pantries' },
          ].map(({ icon, label, sub }) => (
            <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-5">
              <div class="text-2xl mb-2" aria-hidden="true">{icon}</div>
              <p class="font-semibold text-white text-sm mb-1">{label}</p>
              <p class="text-[11px] text-green-300/70 leading-snug">{sub}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────── -->
  <section class="bg-(--cream) py-16 px-4" aria-label="How CityServ works">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">No nonsense</p>
        <h2 class="text-2xl font-bold text-(--forest)">Three steps. That's it.</h2>
      </div>
      <div class="relative">
        <!-- Connector line (desktop) -->
        <div class="hidden sm:block absolute top-10 left-[16.67%] right-[16.67%] h-px bg-gradient-to-r from-transparent via-(--border) to-transparent" aria-hidden="true"></div>
        <div class="grid gap-8 sm:grid-cols-3">
          {STEPS.map(({ number, icon, title, body }) => (
            <div class="flex flex-col items-center text-center">
              <div class="relative mb-5 flex h-20 w-20 items-center justify-center rounded-2xl border-2 border-(--border) bg-white shadow-[var(--shadow)]">
                <span class="text-3xl" aria-hidden="true">{icon}</span>
                <span class="absolute -top-2.5 -right-2.5 flex h-6 w-6 items-center justify-center rounded-full bg-(--forest) text-[10px] font-black text-white">{number}</span>
              </div>
              <h3 class="font-bold text-(--forest) text-base mb-2">{title}</h3>
              <p class="text-sm text-(--text-muted) leading-relaxed max-w-[200px]">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── TRUST STRIP ───────────────────────────────────────────── -->
  <section class="bg-white border-t border-(--border) py-10 px-4" aria-label="Verification sources">
    <div class="mx-auto max-w-6xl">
      <p class="text-center text-[11px] font-semibold uppercase tracking-widest text-(--text-muted) mb-6">Every organization is verified against</p>
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10">
        {[
          { icon: '🏛️', name: 'IRS TEOS', sub: '501(c)(3) status' },
          { icon: '📊', name: 'ProPublica', sub: 'Nonprofit Explorer' },
          { icon: '🎓', name: 'Friends Seminary', sub: 'Service Office' },
          { icon: '🌐', name: 'AmeriCorps', sub: 'Grantee lists' },
          { icon: '⭐', name: 'Reputability Score', sub: 'Updated nightly' },
        ].map(({ icon, name, sub }) => (
          <div class="flex items-center gap-2.5">
            <span class="text-xl" aria-hidden="true">{icon}</span>
            <div>
              <p class="text-xs font-semibold text-(--forest)">{name}</p>
              <p class="text-[10px] text-(--text-muted)">{sub}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/about" class="inline-flex items-center gap-1.5 text-sm font-medium text-(--forest-light) hover:text-(--forest) transition-colors">
          Learn how verification works
          <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ─────────────────────────────────────────────── -->
  <section class="bg-(--cream-dark) py-16 px-4 border-t border-(--border)" aria-label="Sign up call to action">
    <div class="mx-auto max-w-2xl text-center">
      <div class="text-4xl mb-4" aria-hidden="true">🌿</div>
      <h2 class="text-3xl font-extrabold text-(--forest) mb-3">Ready to give back?</h2>
      <p class="text-(--text-muted) text-sm leading-relaxed mb-8 max-w-md mx-auto">
        Create a free account to save opportunities, track your volunteer hours, and earn a spot on the community leaderboard.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/signin" class="inline-flex items-center justify-center gap-2 rounded-full bg-(--forest) px-7 py-3.5 text-sm font-semibold text-white shadow-md transition-all hover:bg-(--forest-mid) hover:-translate-y-0.5 hover:shadow-lg">
          Get started — it's free
        </a>
        <a href="/search" class="inline-flex items-center justify-center gap-2 rounded-full border border-(--border) bg-white px-7 py-3.5 text-sm font-semibold text-(--forest) shadow-[var(--shadow)] transition-all hover:-translate-y-0.5">
          Browse without signing in
        </a>
      </div>
      <p class="mt-5 text-[11px] text-(--text-muted)">No spam. No data sold. Never.</p>
    </div>
  </section>

</Base>
