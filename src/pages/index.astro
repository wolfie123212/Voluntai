---
import Base from '../layouts/Base.astro';
import HeroA from '../components/HeroA.astro';
import HeroB from '../components/HeroB.astro';
import HeroC from '../components/HeroC.astro';
import OrgCard from '../components/OrgCard.astro';
import type { OrgSearchRow } from '../lib/search';

// Time-based hero — server-side NYC timezone, no client JS needed
const nyHour = parseInt(
  new Date().toLocaleString('en-US', {
    timeZone: 'America/New_York',
    hour: 'numeric',
    hour12: false,
  })
);
// Morning 6–11: HeroB (bright blue sky)
// Day 11–19: HeroA (golden hour glow)
// Night 19–6: HeroC (dusk / stars)
const heroVariant: 'A' | 'B' | 'C' =
  nyHour >= 6 && nyHour < 11 ? 'B' : nyHour >= 11 && nyHour < 19 ? 'A' : 'C';

let featuredOrgs: OrgSearchRow[] = [];
try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    const result = await db
      .prepare(`SELECT * FROM organizations WHERE status = 'published' ORDER BY reputability_cached DESC LIMIT 3`)
      .all<OrgSearchRow>();
    featuredOrgs = result.results;
  }
} catch {
  // DB unavailable in local dev without wrangler
}

const CATEGORIES = [
  { label: 'Food & Hunger',  icon: '🍽️', q: 'food'    },
  { label: 'Seniors',        icon: '🤝', q: 'seniors' },
  { label: 'Youth',          icon: '🎓', q: 'youth'   },
  { label: 'Housing',        icon: '🏠', q: 'housing' },
  { label: 'Animals',        icon: '🐾', q: 'animals' },
  { label: 'Health',         icon: '💚', q: 'health'  },
];

const HOW_IT_WORKS = [
  {
    icon: '🔍',
    title: 'Search & filter',
    body: 'Browse by cause, schedule, or neighborhood. Every listing is hand-reviewed.',
  },
  {
    icon: '✅',
    title: 'Trust at a glance',
    body: 'IRS 501(c)(3) status, reputability score, and community reviews — right on each org page.',
  },
  {
    icon: '🤝',
    title: 'Sign up directly',
    body: "No middleman. Each \"Sign up\" button goes straight to the organization's own registration page.",
  },
];
---

<Base title="Home" heroNav={true}>

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="relative min-h-[88vh] flex flex-col justify-center overflow-hidden -mt-14" aria-label="Hero">

    <!-- Illustrated background (time-based) -->
    <div class="absolute inset-0 w-full h-full" aria-hidden="true">
      {heroVariant === 'A' && <HeroA />}
      {heroVariant === 'B' && <HeroB />}
      {heroVariant === 'C' && <HeroC />}
    </div>

    <!-- Overlays — top-to-bottom dark fade + left-side text scrim -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/10 to-transparent pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/40 via-black/10 to-transparent pointer-events-none" aria-hidden="true"></div>

    <!-- Content — left aligned -->
    <div class="relative z-10 w-full px-6 sm:px-10 lg:px-20 pb-16 pt-24 sm:pt-28">
      <div class="max-w-xl">

        <!-- Location badge -->
        <span class="inline-flex items-center gap-1.5 rounded-full border border-white/30 bg-white/12 backdrop-blur-sm px-4 py-1.5 text-[12px] font-semibold tracking-wide text-white/90 mb-5">
          <span class="h-1.5 w-1.5 rounded-full bg-(--leaf) inline-block"></span>
          East Village · Lower East Side · Alphabet City
        </span>

        <h1 class="text-[clamp(2.4rem,6.5vw,4rem)] font-extrabold leading-[1.02] tracking-tight text-white" style="text-shadow: 0 2px 28px rgba(0,0,0,0.4)">
          Serve your city.<br/>Find your cause.
        </h1>

        <p class="mt-5 text-[1.05rem] leading-relaxed text-white/85 max-w-[400px]" style="text-shadow: 0 1px 12px rgba(0,0,0,0.35)">
          Verified volunteer opportunities in NYC's East Village —
          trusted, real, and ready for you.
        </p>

        <!-- Search bar -->
        <form action="/search" method="get" class="mt-7 flex w-full max-w-[460px] items-center gap-2 rounded-full border border-white/30 bg-white/15 backdrop-blur-md px-5 py-2.5 shadow-xl" role="search" aria-label="Search volunteer opportunities">
          <svg class="h-4 w-4 shrink-0 text-white/60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/>
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Search opportunities…"
            class="flex-1 bg-transparent text-[15px] text-white placeholder-white/50 outline-none min-w-0"
            aria-label="Keyword search"
          />
          <button
            type="submit"
            class="shrink-0 rounded-full bg-white px-5 py-2 text-[14px] font-semibold text-(--forest) transition-opacity hover:opacity-90"
          >
            Find →
          </button>
        </form>

        <p class="mt-3 text-[11px] text-white/50">
          Verified by IRS, ProPublica &amp; Friends Seminary Service Office
        </p>

        <!-- Social proof pill -->
        <div class="mt-7 inline-flex items-center gap-2.5 rounded-2xl border border-white/20 bg-white/10 backdrop-blur-sm px-4 py-2.5 shadow-lg">
          <div class="flex -space-x-1.5">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-(--forest)/80 text-[11px] font-bold text-white ring-1 ring-white/20">W</span>
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-(--forest-mid)/80 text-[11px] font-bold text-white ring-1 ring-white/20">A</span>
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-(--leaf)/70 text-[11px] font-bold text-white ring-1 ring-white/20">J</span>
          </div>
          <p class="text-[12px] font-medium text-white/90">
            <span class="font-bold text-white">47 volunteers</span> signed up this month in East Village
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── CATEGORIES ────────────────────────────────────────────── -->
  <section class="bg-(--cream) py-12 px-4" aria-label="Browse by category">
    <div class="mx-auto max-w-6xl">
      <p class="mb-6 text-center text-xs font-semibold uppercase tracking-widest text-(--text-muted)">Browse by cause</p>
      <div class="grid grid-cols-3 gap-3 sm:grid-cols-6">
        {CATEGORIES.map(({ label, icon, q }) => (
          <a
            href={`/search?q=${q}`}
            class="group flex flex-col items-center gap-2 rounded-2xl border border-(--border) bg-white px-3 py-5 text-center shadow-[var(--shadow)] transition-all hover:-translate-y-0.5 hover:border-(--leaf) hover:shadow-[var(--shadow-lg)]"
          >
            <span class="text-2xl" aria-hidden="true">{icon}</span>
            <span class="text-[11px] font-semibold text-(--forest-light) group-hover:text-(--forest) transition-colors">{label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FEATURED ORGS ─────────────────────────────────────────── -->
  {featuredOrgs.length > 0 && (
    <section class="bg-(--cream-dark) py-16 px-4" aria-label="Featured organizations">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex items-end justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Trusted partners</p>
            <h2 class="text-2xl font-bold text-(--forest)">Featured Organizations</h2>
          </div>
          <a href="/search" class="hidden sm:inline-flex items-center gap-1 text-sm font-medium text-(--forest-light) hover:text-(--forest) transition-colors">
            View all
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
          </a>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featuredOrgs.map((org) => (
            <OrgCard org={org} />
          ))}
        </div>
        <div class="mt-6 text-center sm:hidden">
          <a href="/search" class="inline-flex items-center gap-1 text-sm font-medium text-(--forest-light) hover:text-(--forest) transition-colors">
            View all organizations →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── HOW IT WORKS ──────────────────────────────────────────── -->
  <section class="bg-(--cream) py-16 px-4" aria-label="How CityServ works">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Simple &amp; transparent</p>
        <h2 class="text-2xl font-bold text-(--forest)">How CityServ works</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        {HOW_IT_WORKS.map(({ icon, title, body }) => (
          <div class="rounded-2xl border border-(--border) bg-white p-7 shadow-[var(--shadow)] text-center">
            <div class="mb-4 flex items-center justify-center">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-(--cream) text-2xl shadow-inner">
                {icon}
              </div>
            </div>
            <h3 class="font-semibold text-(--forest) mb-2">{title}</h3>
            <p class="text-sm text-(--text-muted) leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TRUST BANNER ──────────────────────────────────────────── -->
  <section class="bg-(--forest) py-16 px-4" aria-label="Verification promise">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-5 flex items-center justify-center gap-2">
        <span class="inline-block h-px w-10 bg-(--leaf-light) opacity-50"></span>
        <span class="text-(--leaf-light) text-xs font-semibold uppercase tracking-widest">Our promise</span>
        <span class="inline-block h-px w-10 bg-(--leaf-light) opacity-50"></span>
      </div>
      <h2 class="text-2xl font-bold text-white mb-4">Every organization is verified</h2>
      <p class="text-(--leaf-light) text-sm leading-relaxed max-w-md mx-auto">
        We cross-reference IRS records, ProPublica nonprofit data, and AmeriCorps grantee lists
        before any organization appears on CityServ.
      </p>
      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {[
          { icon: '🏛️', title: 'IRS 501(c)(3)',    sub: 'Tax-exempt status via ProPublica' },
          { icon: '🎓', title: 'School verified',   sub: 'Friends Seminary Service Office' },
          { icon: '⭐', title: 'Trust score',        sub: 'Multi-source index, updated nightly' },
        ].map(({ icon, title, sub }) => (
          <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-6">
            <div class="text-2xl mb-3" aria-hidden="true">{icon}</div>
            <p class="font-semibold text-white text-sm mb-1">{title}</p>
            <p class="text-[11px] text-(--leaf-light) opacity-80">{sub}</p>
          </div>
        ))}
      </div>
      <a
        href="/about"
        class="mt-8 inline-flex items-center gap-1.5 rounded-full border border-white/20 px-5 py-2.5 text-sm font-medium text-white/80 transition-colors hover:bg-white/10 hover:text-white"
      >
        Learn how we verify
        <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
      </a>
    </div>
  </section>

</Base>
