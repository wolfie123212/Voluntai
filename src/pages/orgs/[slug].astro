---
import Base from '../../layouts/Base.astro';
import TrustBadge from '../../components/TrustBadge.astro';
import OpportunityCard from '../../components/OpportunityCard.astro';
import { parseCategories, getOrgOpportunities } from '../../lib/search';
import type { OrgSearchRow, OpportunityRow } from '../../lib/search';
import { trustTier, TRUST_TIER_LABEL } from '../../lib/score';
import { createAuth } from '../../lib/auth';

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/search');

let org: OrgSearchRow | null = null;
let opps: OpportunityRow[] = [];

interface ReviewRow {
  id: number;
  rating: number;
  body: string | null;
  volunteered_in_year: number;
  created_at: string;
  reviewer_name: string | null;
}

let reviews: ReviewRow[] = [];
let session: { user?: { id?: string } } | null = null;

try {
  const env = Astro.locals.runtime?.env;
  const db = env?.DB;
  if (db) {
    const result = await db
      .prepare(`SELECT * FROM organizations WHERE slug = ? AND status = 'published' LIMIT 1`)
      .bind(slug)
      .all<OrgSearchRow>();
    org = result.results[0] ?? null;

    if (org) {
      opps = await getOrgOpportunities(db, org.id);

      const reviewResult = await db
        .prepare(`SELECT r.id, r.rating, r.body, r.volunteered_in_year, r.created_at,
                         u.display_name as reviewer_name
                  FROM reviews r
                  JOIN users u ON u.id = r.user_id
                  WHERE r.org_id = ? AND r.status = 'published'
                  ORDER BY r.created_at DESC
                  LIMIT 50`)
        .bind(org.id)
        .all<ReviewRow>();
      reviews = reviewResult.results;
    }

    if (env) {
      const auth = createAuth(env);
      session = await auth.api.getSession({ headers: Astro.request.headers });
    }
  }
} catch {
  // DB unavailable
}

if (!org) return Astro.redirect('/search');

const categories = parseCategories(org.categories);
const tier = trustTier(org.reputability_cached);

const verificationBadges = [
  org.is_irs_501c3 && { label: 'IRS 501(c)(3)', detail: org.irs_status === 'PUBLIC_CHARITY' ? 'Public Charity' : org.irs_status ?? 'Tax-exempt', icon: '🏛️' },
  org.admin_verified_by && { label: 'Staff Verified', detail: 'Friends Seminary Service Office', icon: '🎓' },
  org.is_americorps_grantee && { label: 'AmeriCorps Grantee', detail: 'Federal service program partner', icon: '🇺🇸' },
  org.charity_nav_stars && { label: `${org.charity_nav_stars}-Star Rating`, detail: 'Charity Navigator', icon: '⭐' },
].filter(Boolean) as Array<{ label: string; detail: string; icon: string }>;

// Average rating
const avgRating = reviews.length
  ? (reviews.reduce((s, r) => s + r.rating, 0) / reviews.length).toFixed(1)
  : null;
---

<Base
  title={org.name}
  description={org.description ?? org.mission ?? `Volunteer with ${org.name} in NYC's East Village.`}
>
  <!-- ── BREADCRUMB / PAGE HEADER ───────────────────────────────── -->
  <div class="bg-white border-b border-(--border)">
    <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between gap-4 flex-wrap">
      <nav class="text-xs text-(--text-muted)" aria-label="Breadcrumb">
        <a href="/" class="hover:text-(--forest) transition-colors">Home</a>
        <span class="mx-1.5 opacity-40">›</span>
        <a href="/search" class="hover:text-(--forest) transition-colors">Find Opportunities</a>
        <span class="mx-1.5 opacity-40">›</span>
        <span class="text-(--forest)">{org.name}</span>
      </nav>
      <!-- Top-level signup CTA — links to first opp or org website -->
      {(opps[0]?.signup_url ?? org.website) && (
        <a
          href={opps[0]?.signup_url ?? org.website!}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-(--forest) px-5 py-2 text-sm font-semibold text-white hover:bg-(--forest-mid) transition-colors shadow-sm"
        >
          Sign up to volunteer
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      )}
    </div>
  </div>

  <div class="bg-(--cream) min-h-screen">
    <div class="mx-auto max-w-6xl px-4 py-10">

      <!-- ── ORG HEADER ─────────────────────────────────────────── -->
      <div class="mb-8 rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)]">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <h1 class="text-2xl font-bold text-(--forest) sm:text-3xl leading-tight">{org.name}</h1>
            {org.neighborhood && (
              <p class="mt-1 flex items-center gap-1 text-sm text-(--text-muted)">
                <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                {org.neighborhood}
              </p>
            )}
            {avgRating && (
              <p class="mt-1 text-sm text-(--amber) font-medium">
                {'★'.repeat(Math.round(Number(avgRating)))}{'☆'.repeat(5 - Math.round(Number(avgRating)))}
                <span class="ml-1 text-(--text-muted) font-normal">{avgRating} · {reviews.length} review{reviews.length !== 1 ? 's' : ''}</span>
              </p>
            )}
          </div>
          <TrustBadge score={org.reputability_cached} />
        </div>

        {categories.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {categories.map((cat) => (
              <a
                href={`/search?q=${cat}`}
                class="rounded-full bg-(--cream) border border-(--border) px-3 py-1 text-xs font-medium text-(--forest-light) capitalize hover:border-(--leaf) hover:text-(--forest) transition-colors"
              >
                {cat.replace(/_/g, ' ')}
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- ── TWO-COLUMN LAYOUT ──────────────────────────────────── -->
      <div class="grid gap-6 lg:grid-cols-3">

        <!-- MAIN CONTENT ─────────────────────────────────────────── -->
        <div class="lg:col-span-2 space-y-6">

          <!-- Opportunities (first — it's the primary action) -->
          <section aria-label="Volunteer opportunities">
            <div class="mb-3 flex items-center justify-between">
              <h2 class="text-base font-semibold text-(--forest) flex items-center gap-2">
                Volunteer Opportunities
                {opps.length > 0 && (
                  <span class="rounded-full bg-(--cream) border border-(--border) px-2.5 py-0.5 text-xs font-normal text-(--text-muted)">
                    {opps.length}
                  </span>
                )}
              </h2>
            </div>

            {opps.length > 0 ? (
              <div class="space-y-3">
                {opps.map((opp) => <OpportunityCard opp={opp} />)}
              </div>
            ) : (
              <div class="rounded-2xl border border-(--border) border-dashed bg-white px-6 py-10 text-center">
                <p class="text-(--text-muted) text-sm mb-2">No opportunities listed yet.</p>
                {org.website && (
                  <a
                    href={org.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-sm text-(--forest-light) hover:text-(--forest) transition-colors font-medium"
                  >
                    Visit {org.name}'s website →
                  </a>
                )}
              </div>
            )}
          </section>

          <!-- Mission (after opportunities — context, not conversion) -->
          {(org.mission || org.description) && (
            <section aria-label="About this organization" class="rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)]">
              <h2 class="mb-3 text-base font-semibold text-(--forest)">About</h2>
              <p class="text-(--text-muted) leading-relaxed text-sm">
                {org.mission ?? org.description}
              </p>
              {org.mission && org.description && org.description !== org.mission && (
                <p class="mt-3 text-sm text-(--text-muted) leading-relaxed opacity-80">{org.description}</p>
              )}
            </section>
          )}

          <!-- Reviews -->
          <section aria-label="Volunteer reviews">
            <div class="mb-3 flex items-center justify-between">
              <h2 class="text-base font-semibold text-(--forest) flex items-center gap-2">
                Reviews
                {reviews.length > 0 && (
                  <span class="rounded-full bg-(--cream) border border-(--border) px-2.5 py-0.5 text-xs font-normal text-(--text-muted)">
                    {reviews.length}
                  </span>
                )}
              </h2>
              <a
                href={session?.user ? `/orgs/${slug}/review/new` : `/signin?redirect=/orgs/${slug}/review/new`}
                class="rounded-full bg-(--forest) px-4 py-1.5 text-sm font-medium text-white hover:bg-(--forest-mid) transition-colors"
              >
                Write a review
              </a>
            </div>

            {reviews.length === 0 ? (
              <div class="rounded-2xl border border-(--border) border-dashed bg-white px-6 py-10 text-center">
                <p class="text-(--text-muted) text-sm">No reviews yet. Be the first to share your experience.</p>
              </div>
            ) : (
              <div class="space-y-3">
                {reviews.map((r) => (
                  <div class="rounded-2xl border border-(--border) bg-white p-5 shadow-[var(--shadow)]">
                    <div class="flex items-start justify-between gap-3 mb-2">
                      <div class="flex items-center gap-2">
                        <span class="text-sm text-(--amber)">{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span>
                        <span class="text-xs text-(--text-muted)">{r.volunteered_in_year}</span>
                      </div>
                      <p class="text-xs text-(--text-muted) shrink-0">{new Date(r.created_at).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</p>
                    </div>
                    {r.body && <p class="text-sm text-(--forest) leading-relaxed">{r.body}</p>}
                    <div class="mt-3 flex items-center justify-between">
                      {r.reviewer_name && (
                        <p class="text-xs font-medium text-(--text-muted)">— {r.reviewer_name}</p>
                      )}
                      <a
                        href={`/contact?type=takedown&review_id=${r.id}`}
                        class="ml-auto text-xs text-(--text-muted) hover:text-(--forest) transition-colors"
                      >
                        Report
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </section>

        </div>

        <!-- SIDEBAR ────────────────────────────────────────────────── -->
        <aside class="space-y-4" aria-label="Organization details">

          <!-- Verification -->
          {verificationBadges.length > 0 && (
            <div class="rounded-2xl border border-(--border) bg-white p-5 shadow-[var(--shadow)]">
              <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-(--text-muted)">
                Verification
              </h3>
              <ul class="space-y-3">
                {verificationBadges.map(({ label, detail, icon }) => (
                  <li class="flex items-start gap-3">
                    <span class="text-lg mt-0.5 shrink-0" aria-hidden="true">{icon}</span>
                    <div>
                      <p class="text-sm font-medium text-(--forest)">{label}</p>
                      <p class="text-xs text-(--text-muted)">{detail}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Contact -->
          <div class="rounded-2xl border border-(--border) bg-white p-5 shadow-[var(--shadow)]">
            <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-(--text-muted)">
              Contact
            </h3>
            <div class="space-y-3">
              {org.website && (
                <a
                  href={org.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-sm text-(--forest-light) hover:text-(--forest) transition-colors break-all font-medium"
                >
                  <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                  </svg>
                  {org.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                </a>
              )}
              {org.phone && (
                <a
                  href={`tel:${org.phone}`}
                  class="flex items-center gap-2 text-sm text-(--forest-light) hover:text-(--forest) transition-colors font-medium"
                >
                  <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"/>
                  </svg>
                  {org.phone}
                </a>
              )}
              {org.address_line1 && (
                <a
                  href={`https://maps.google.com/?q=${encodeURIComponent(`${org.address_line1}${org.city ? `, ${org.city}` : ''}${org.state ? `, ${org.state}` : ''}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-start gap-2 text-sm text-(--forest-light) hover:text-(--forest) transition-colors font-medium"
                >
                  <svg class="h-4 w-4 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span>{org.address_line1}{org.city ? `, ${org.city}` : ''}{org.state ? `, ${org.state}` : ''} ↗</span>
                </a>
              )}
              {!org.website && !org.phone && !org.address_line1 && (
                <p class="text-sm text-(--text-muted)">No contact info available.</p>
              )}
            </div>
          </div>

          <!-- Report link -->
          <p class="text-center text-xs text-(--text-muted)">
            Something wrong?
            <a href={`/contact?type=takedown&org=${slug}`} class="underline hover:text-(--forest) transition-colors">
              Report this listing
            </a>
          </p>
        </aside>

      </div>
    </div>
  </div>
</Base>
