---
import Base from '../layouts/Base.astro';
import PixelIcon, { type PixelIconName } from '../components/PixelIcon.astro';
import SearchBar from '../components/SearchBar.astro';
import OrgCard from '../components/OrgCard.astro';
import { searchOrgs } from '../lib/search';
import type { OrgSearchRow } from '../lib/search';

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q') ?? '';

let orgs: OrgSearchRow[] = [];
let error = false;

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    orgs = await searchOrgs(db, { q, limit: 20 });
  }
} catch {
  error = true;
}

const pageTitle = q ? `"${q}" — Search` : 'Find Opportunities';
const resultSummary = q
  ? `${orgs.length} organization${orgs.length !== 1 ? 's' : ''} matching "${q}"`
  : `${orgs.length} verified organization${orgs.length !== 1 ? 's' : ''} in the East Village`;

const QUICK_FILTERS: { label: string; q: string; icon: PixelIconName }[] = [
  { label: 'Food & Hunger',  q: 'food',        icon: 'plate' },
  { label: 'Seniors',        q: 'seniors',      icon: 'handshake' },
  { label: 'Youth',          q: 'youth',        icon: 'cap' },
  { label: 'Housing',        q: 'housing',      icon: 'house' },
  { label: 'Animals',        q: 'animals',      icon: 'paw' },
  { label: 'Health',         q: 'health',       icon: 'heart' },
  { label: 'Environment',    q: 'environment',  icon: 'sprout' },
  { label: 'Arts & Culture', q: 'arts',         icon: 'palette' },
];
---

<Base title={pageTitle} description={`Volunteer opportunities in NYC's East Village. ${resultSummary}.`}>

  <!-- ── SEARCH HEADER ─────────────────────────────────────────── -->
  <div class="bg-white border-b border-(--border) px-4 py-6 shadow-sm">
    <div class="mx-auto max-w-3xl">
      <!-- Breadcrumb -->
      <p class="text-xs text-(--text-muted) mb-3">
        <a href="/" class="hover:text-(--forest) transition-colors">Home</a>
        <span class="mx-1.5 opacity-40">›</span>
        Find Opportunities
      </p>
      <SearchBar q={q} large={true} />

      <!-- Quick filter chips -->
      <div class="mt-4 flex flex-wrap gap-2" aria-label="Quick filters">
        {QUICK_FILTERS.map(({ label, q: fq, icon }) => (
          <a
            href={`/search?q=${fq}`}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-all hover:-translate-y-px',
              q === fq
                ? 'border-(--forest) bg-(--forest) text-white shadow-sm'
                : 'border-(--border) bg-(--cream) text-(--forest-light) hover:border-(--leaf) hover:text-(--forest) hover:bg-white'
            ]}
          >
            <PixelIcon name={icon} size={16} />
            {label}
          </a>
        ))}
        {q && !QUICK_FILTERS.some(f => f.q === q) && (
          <span class="inline-flex items-center gap-1 rounded-full border border-amber-300 bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-800">
            "{q}"
          </span>
        )}
        {q && (
          <a
            href="/search"
            class="inline-flex items-center gap-1 rounded-full border border-(--border) px-3 py-1.5 text-xs font-medium text-(--text-muted) hover:text-(--forest) hover:border-(--leaf) transition-colors"
          >
            ✕ Clear
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- ── RESULTS ───────────────────────────────────────────────── -->
  <div class="bg-(--cream) min-h-[60vh] px-4 py-10">
    <div class="mx-auto max-w-6xl">

      <!-- Result count -->
      <div class="mb-6">
        <p class="text-sm text-(--text-muted)">
          {error
            ? 'Search is unavailable right now. Try again in a moment.'
            : resultSummary}
        </p>
      </div>

      {orgs.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {orgs.map((org) => <OrgCard org={org} />)}
        </div>
      ) : !error && (
        <div class="flex flex-col items-center gap-4 py-24 text-center">
          <p class="text-lg font-semibold text-(--forest)">
            {q ? `No results for "${q}"` : 'No organizations found'}
          </p>
          <p class="text-sm text-(--text-muted) max-w-xs leading-relaxed">
            {q
              ? 'Try a different keyword — like "food", "youth", or "seniors".'
              : 'Check back soon as we add more verified organizations.'}
          </p>
          {q && (
            <a
              href="/search"
              class="mt-2 rounded-full border border-(--border) bg-white px-5 py-2 text-sm font-medium text-(--forest) hover:border-(--leaf) hover:shadow-[var(--shadow)] transition-all"
            >
              Browse all organizations
            </a>
          )}
        </div>
      )}
    </div>
  </div>

</Base>
