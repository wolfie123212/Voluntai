---
import Base from '../layouts/Base.astro';
import { verifyTurnstile } from '../lib/turnstile';

const env = Astro.locals.runtime?.env;
const siteKey = env?.TURNSTILE_SITE_KEY ?? '';
const type = new URL(Astro.request.url).searchParams.get('type') ?? 'general';
const isTakedown = type === 'takedown';

let error = '';
let success = false;

if (Astro.request.method === 'POST' && env) {
  const form = await Astro.request.formData();
  const reason = String(form.get('reason') ?? '').trim();
  const details = String(form.get('details') ?? '').slice(0, 4000).trim();
  const reporterEmail = String(form.get('email') ?? '').trim();
  const reporterName = String(form.get('name') ?? '').trim();
  const reviewId = form.get('review_id') ? parseInt(String(form.get('review_id'))) : undefined;
  const orgId = form.get('org_id') ? parseInt(String(form.get('org_id'))) : undefined;
  const turnstileToken = String(form.get('cf-turnstile-response') ?? '');

  if (!reason) {
    error = 'Please select a reason.';
  } else {
    const turnstileOk = await verifyTurnstile(turnstileToken, env.TURNSTILE_SECRET_KEY);
    if (!turnstileOk) {
      error = 'CAPTCHA verification failed. Please try again.';
    } else {
      await env.DB
        .prepare(`INSERT INTO reports (review_id, org_id, reporter_email, reporter_name, reason, details)
                  VALUES (?, ?, ?, ?, ?, ?)`)
        .bind(reviewId ?? null, orgId ?? null, reporterEmail || null, reporterName || null, reason, details || null)
        .run();
      success = true;
    }
  }
}

const REASONS = [
  { value: 'defamation', label: 'Defamation / false statement of fact' },
  { value: 'dmca', label: 'Copyright infringement (DMCA)' },
  { value: 'harassment', label: 'Harassment or threats' },
  { value: 'pii', label: 'Personal information exposed' },
  { value: 'spam', label: 'Spam or fake review' },
  { value: 'inaccurate', label: 'Inaccurate organization info' },
  { value: 'other', label: 'Other' },
];
---

<Base title={isTakedown ? 'Takedown Request' : 'Contact'}>
  <div class="min-h-[80vh] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-xl">

      {success ? (
        <!-- Success state -->
        <div class="rounded-2xl border border-(--border) bg-white p-10 shadow-[var(--shadow)] text-center">
          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-green-50">
            <svg class="h-8 w-8 text-(--forest)" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
          </div>
          <h1 class="mb-3 text-2xl font-bold text-(--forest)">Report received</h1>
          <p class="text-(--text-muted) leading-relaxed">
            We'll review your {isTakedown ? 'takedown request' : 'report'} within 7 days and follow up at the email you provided.
          </p>
          <p class="mt-4 text-sm text-(--text-muted)">
            For urgent matters, email
            <a href="mailto:takedown@cityserv.org" class="font-medium text-(--forest-light) underline underline-offset-2 hover:text-(--forest)">takedown@cityserv.org</a>
            directly.
          </p>
          <a href="/" class="mt-8 inline-flex items-center gap-1.5 rounded-xl bg-(--forest) px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-(--forest-mid) transition-colors">
            Back to home
          </a>
        </div>
      ) : (
        <>
          <!-- Header -->
          <div class="mb-8 text-center">
            <div class:list={[
              'mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl shadow-lg',
              isTakedown ? 'bg-amber-500' : 'bg-(--forest)'
            ]}>
              {isTakedown ? (
                <svg class="h-6 w-6 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5" />
                </svg>
              ) : (
                <svg class="h-6 w-6 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
              )}
            </div>
            <h1 class="text-2xl font-bold text-(--forest)">
              {isTakedown ? 'Takedown / Report Request' : 'Contact Us'}
            </h1>
            <p class="mt-1.5 text-sm text-(--text-muted) max-w-sm mx-auto">
              {isTakedown
                ? 'Use this form to report content that violates our policies, infringes copyright, or is defamatory. We respond within 7 days.'
                : 'Questions, feedback, or content concerns — we\'re here to help.'}
            </p>
          </div>

          <!-- Card -->
          <div class="rounded-2xl border border-(--border) bg-white p-8 shadow-[var(--shadow)]">

            {error && (
              <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 shrink-0 text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                  </svg>
                  {error}
                </div>
              </div>
            )}

            <form method="post" class="space-y-5" novalidate>
              <div>
                <label for="reason" class="mb-1.5 block text-sm font-medium text-(--forest)">
                  Reason <span class="text-red-500">*</span>
                </label>
                <select id="reason" name="reason" required
                  class="w-full rounded-xl border border-(--border) bg-(--cream) px-4 py-2.5 text-(--forest) focus:border-(--leaf) focus:outline-none focus:ring-2 focus:ring-(--leaf)/20 transition-all">
                  <option value="">Select a reason…</option>
                  {REASONS.map((r) => <option value={r.value}>{r.label}</option>)}
                </select>
              </div>
              <div>
                <label for="details" class="mb-1.5 block text-sm font-medium text-(--forest)">Details</label>
                <textarea id="details" name="details" rows="5" maxlength="4000"
                  class="w-full rounded-xl border border-(--border) bg-(--cream) px-4 py-2.5 text-(--forest) placeholder-(--text-muted)/60 focus:border-(--leaf) focus:outline-none focus:ring-2 focus:ring-(--leaf)/20 transition-all resize-y"
                  placeholder="Describe the issue, include any URLs or review IDs…"></textarea>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="name" class="mb-1.5 block text-sm font-medium text-(--forest)">Your name</label>
                  <input id="name" name="name" type="text" autocomplete="name"
                    class="w-full rounded-xl border border-(--border) bg-(--cream) px-4 py-2.5 text-(--forest) placeholder-(--text-muted)/60 focus:border-(--leaf) focus:outline-none focus:ring-2 focus:ring-(--leaf)/20 transition-all"
                    placeholder="Optional" />
                </div>
                <div>
                  <label for="email" class="mb-1.5 block text-sm font-medium text-(--forest)">Your email</label>
                  <input id="email" name="email" type="email" autocomplete="email"
                    class="w-full rounded-xl border border-(--border) bg-(--cream) px-4 py-2.5 text-(--forest) placeholder-(--text-muted)/60 focus:border-(--leaf) focus:outline-none focus:ring-2 focus:ring-(--leaf)/20 transition-all"
                    placeholder="For follow-up" />
                </div>
              </div>

              <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>

              <button type="submit"
                class="w-full rounded-xl bg-(--forest) py-3 font-semibold text-white shadow-sm hover:bg-(--forest-mid) transition-colors focus:outline-none focus:ring-2 focus:ring-(--forest) focus:ring-offset-2">
                Submit
              </button>
            </form>
          </div>

          <!-- Help links -->
          <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4 text-sm text-(--text-muted)">
            {!isTakedown && (
              <a href="/contact?type=takedown" class="hover:text-(--forest) transition-colors">
                Report or takedown request →
              </a>
            )}
            <a href="mailto:contact@cityserv.org" class="hover:text-(--forest) transition-colors">
              contact@cityserv.org
            </a>
          </div>
        </>
      )}
    </div>
  </div>
</Base>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
