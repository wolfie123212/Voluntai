---
import Base from '../layouts/Base.astro';
import type { PixelIconName } from '../components/PixelIcon.astro';
import { createAuth } from '../lib/auth';
import BadgeCard from '../components/BadgeCard.astro';
import QuestCard from '../components/QuestCard.astro';
import { deleteAccount } from '../lib/db/account';

const env = Astro.locals.runtime?.env;

if (!env) return Astro.redirect('/signin');

const auth = createAuth(env);
const session = await auth.api.getSession({ headers: Astro.request.headers });

if (!session?.user) return Astro.redirect('/signin?redirect=/account');

const user = session.user;

// Fetch user's published reviews
interface ReviewRow {
  id: number;
  org_id: number;
  org_name: string;
  org_slug: string;
  rating: number;
  body: string | null;
  volunteered_in_year: number;
  status: string;
  created_at: string;
}

let reviews: ReviewRow[] = [];
try {
  const result = await env.DB
    .prepare(`SELECT r.id, r.org_id, r.rating, r.body, r.volunteered_in_year, r.status, r.created_at,
                     o.name as org_name, o.slug as org_slug
              FROM reviews r
              JOIN organizations o ON o.id = r.org_id
              WHERE r.user_id = ? AND r.status IN ('published','pending')
              ORDER BY r.created_at DESC`)
    .bind(user.id)
    .all<ReviewRow>();
  reviews = result.results;
} catch { /* DB unavailable */ }

// Handle POST for display name update and sign out
let updateMsg = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');

  if (action === 'update_name') {
    const name = String(form.get('name') ?? '').trim();
    if (name) {
      await env.DB.prepare('UPDATE users SET display_name = ? WHERE id = ?').bind(name, user.id).run();
      updateMsg = 'Display name updated.';
      // Refresh the page to reflect display name changes
      return Astro.redirect('/account?updated=true');
    }
  }

  if (action === 'delete_account') {
    if (String(form.get('confirm') ?? '').trim().toUpperCase() !== 'DELETE') {
      return Astro.redirect('/account?delete_error=1#delete-account');
    }
    await deleteAccount(env.DB, user.id);
    const expired = 'Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax';
    Astro.response.headers.append('Set-Cookie', `better-auth.session_token=; ${expired}`);
    Astro.response.headers.append('Set-Cookie', `__Secure-better-auth.session_token=; ${expired}`);
    return Astro.redirect('/?account_deleted=1');
  }

  if (action === 'sign_out') {
    const authReq = new Request(`${env.APP_BASE_URL}/api/auth/sign-out`, {
      method: 'POST',
      headers: Astro.request.headers,
    });
    const authRes = await auth.handler(authReq);
    for (const [k, v] of authRes.headers.entries()) {
      if (k.toLowerCase() === 'set-cookie') Astro.response.headers.append('Set-Cookie', v);
    }
    return Astro.redirect('/');
  }
}

// Check for update URL param
const urlUpdated = new URL(Astro.request.url).searchParams.get('updated');
const deleteError = new URL(Astro.request.url).searchParams.get('delete_error') === '1';
if (urlUpdated === 'true') {
  updateMsg = 'Display name updated successfully.';
}

// Fetch volunteer activity
interface VolunteerRow {
  opportunity_id: number;
  org_id: number;
  opp_title: string;
  org_name: string;
  org_slug: string;
  signup_url: string | null;
  clicked_at: string | null;
  completed_at: string | null;
}
let volunteerActivity: VolunteerRow[] = [];
try {
  const result = await env.DB
    .prepare(`SELECT va.opportunity_id, va.org_id, va.clicked_at, va.completed_at,
                     op.title as opp_title, op.signup_url,
                     o.name as org_name, o.slug as org_slug
              FROM volunteer_actions va
              JOIN opportunities op ON op.id = va.opportunity_id
              JOIN organizations o ON o.id = va.org_id
              WHERE va.user_id = ?
              ORDER BY COALESCE(va.completed_at, va.clicked_at) DESC
              LIMIT 50`)
    .bind(user.id)
    .all<VolunteerRow>();
  volunteerActivity = result.results;
} catch { /* DB unavailable */ }

function stars(n: number) { return '★'.repeat(n) + '☆'.repeat(5 - n); }

// MVP Gamification static data (custom tailored to their reviews count and local NYC theme)
const userLevel = reviews.length >= 3 ? 3 : reviews.length >= 1 ? 2 : 1;
const userXP = reviews.length * 150 + 50; // base + 150XP per review
const nextLevelXP = userLevel === 1 ? 200 : userLevel === 2 ? 500 : 1000;
const xpPercentage = Math.min(100, Math.round((userXP / nextLevelXP) * 100));

const BADGES: { icon: PixelIconName; name: string; description: string; earnedAt?: string }[] = [
  { icon: 'sprout', name: 'First Steps', description: 'Create your account and complete registration.', earnedAt: user.createdAt },
  { icon: 'star', name: 'Reviewer', description: 'Leave your first review for a verified organization.', earnedAt: reviews.length >= 1 ? reviews[reviews.length - 1].created_at : undefined },
  { icon: 'plate', name: 'Hunger Hero', description: 'Complete 3 shifts at a local East Village food pantry.', earnedAt: reviews.some(r => r.org_slug.includes('mission') || r.org_slug.includes('cares')) ? user.createdAt : undefined },
  { icon: 'heart', name: 'On Fire', description: 'Volunteer 3 times in a single calendar month.', earnedAt: undefined },
  { icon: 'handshake', name: 'Community Leader', description: 'Reach volunteer Level 5 with 1,500+ XP.', earnedAt: undefined },
];

const QUESTS = [
  { title: 'East Village Explorer', description: 'Explore and volunteer at 2 different organizations in 10003 or 10009 ZIP codes.', category: 'Discovery', progress: Math.min(2, reviews.length), target: 2, xpReward: 250 },
  { title: 'Food & Hunger Champion', description: 'Complete and review 3 food bank or food rescue sessions.', category: 'Food Pantry', progress: reviews.some(r => r.org_slug.includes('mission')) ? 1 : 0, target: 3, xpReward: 400 },
  { title: 'Trusted Voice', description: 'Write 3 helpful community reviews to earn this badge.', category: 'Community', progress: Math.min(3, reviews.length), target: 3, xpReward: 150 },
];
---

<Base title="My Account">
  <div class="mx-auto max-w-6xl px-4 py-12">
    
    <!-- Profile & Gamification Header Grid -->
    <div class="grid gap-6 md:grid-cols-3 mb-10">
      
      <!-- Profile Box -->
      <div class="md:col-span-2 rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)] flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-4 mb-6">
            <!-- Avatar mockup -->
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-(--forest) text-white font-extrabold text-2xl shadow-md border border-white">
              {((user as unknown as { displayName?: string }).displayName ?? user.name ?? 'U').charAt(0).toUpperCase()}
            </div>
            <div>
              <h1 class="text-xl font-bold text-(--forest)">
                {(user as unknown as { displayName?: string }).displayName ?? user.name ?? 'Volunteer User'}
              </h1>
              <p class="text-xs text-(--text-muted)">{user.email}</p>
              <div class="mt-2 flex items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-(--cream) px-2.5 py-0.5 text-[10px] font-semibold text-(--forest-light)">
                  Role: {user.role || 'Volunteer'}
                </span>
                <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-0.5 text-[10px] font-semibold text-amber-700 border border-amber-200">
                  Level {userLevel} Volunteer
                </span>
              </div>
            </div>
          </div>

          <!-- XP Bar -->
          <div class="space-y-2 mb-6">
            <div class="flex justify-between text-xs font-semibold">
              <span class="text-(--forest)">XP Progress</span>
              <span class="text-(--text-muted)">{userXP} / {nextLevelXP} XP</span>
            </div>
            <div class="h-3 w-full rounded-full bg-(--cream-dark) overflow-hidden shadow-inner">
              <div 
                class="h-full rounded-full bg-gradient-to-r from-(--leaf) to-(--forest-light) transition-all duration-500 ease-out" 
                style={`width: ${xpPercentage}%`}
              ></div>
            </div>
          </div>
        </div>

        {updateMsg && (
          <p class="mb-4 rounded-xl bg-green-50 border border-green-200 px-4 py-2.5 text-sm text-green-800" role="status">
            {updateMsg}
          </p>
        )}

        <!-- Edit Profile Name Form -->
        <form method="post" class="flex gap-3">
          <input type="hidden" name="action" value="update_name" />
          <input
            name="name"
            type="text"
            required
            defaultValue={(user as unknown as { displayName?: string }).displayName ?? (user as any).name ?? ''}
            placeholder="Edit display name"
            class="flex-1 rounded-xl border border-(--border) bg-(--cream) px-4 py-2 text-sm text-(--forest) placeholder-(--text-muted)/60 focus:border-(--leaf) focus:outline-none transition-all"
          />
          <button type="submit" class="rounded-xl bg-(--forest) px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-(--forest-mid) transition-colors">
            Update Name
          </button>
        </form>
      </div>

      <!-- Sign Out / Actions Panel -->
      <div class="rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)] flex flex-col justify-between">
        <div>
          <h2 class="font-bold text-(--forest) mb-3">Volunteer Stats</h2>
          <div class="grid grid-cols-2 gap-3 text-center mb-6">
            <div class="rounded-xl bg-(--cream) p-3 shadow-inner">
              <p class="text-2xl font-black text-(--forest)">{reviews.length}</p>
              <p class="text-[10px] font-semibold text-(--text-muted) uppercase tracking-wider mt-0.5">Reviews</p>
            </div>
            <div class="rounded-xl bg-(--cream) p-3 shadow-inner">
              <p class="text-2xl font-black text-(--forest)">{userXP}</p>
              <p class="text-[10px] font-semibold text-(--text-muted) uppercase tracking-wider mt-0.5">Total XP</p>
            </div>
          </div>
        </div>

        <form method="post" class="w-full">
          <input type="hidden" name="action" value="sign_out" />
          <button type="submit" class="w-full rounded-xl border border-red-200 py-3 text-sm font-semibold text-red-600 hover:bg-red-50 hover:border-red-300 transition-colors">
            Sign out
          </button>
        </form>
      </div>
    </div>

    <!-- Active Quests -->
    <section class="mb-10">
      <div class="mb-6 flex items-end justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Challenges</p>
          <h2 class="text-xl font-bold text-(--forest)">Active Quests</h2>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {QUESTS.map((quest) => (
          <QuestCard {...quest} />
        ))}
      </div>
    </section>

    <!-- Badges Grid -->
    <section class="mb-10">
      <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Achievements</p>
        <h2 class="text-xl font-bold text-(--forest)">Volunteer Badges</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {BADGES.map((badge) => (
          <BadgeCard {...badge} />
        ))}
      </div>
    </section>

    <!-- Volunteer Activity -->
    <section class="mb-10">
      <div class="mb-6 flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Activity</p>
          <h2 class="text-xl font-bold text-(--forest)">My Volunteering</h2>
        </div>
        <a href="/leaderboard" class="text-sm font-medium text-(--forest) underline underline-offset-2 hover:text-(--forest-mid) whitespace-nowrap">
          View leaderboard →
        </a>
      </div>

      {volunteerActivity.length === 0 ? (
        <div class="rounded-2xl border border-(--border) bg-white px-6 py-10 text-center shadow-[var(--shadow)]">
          <p class="text-(--text-muted) text-sm leading-relaxed max-w-sm mx-auto">
            When you click "Sign up directly" on an opportunity, it'll appear here so you can mark it done.
          </p>
          <a href="/search" class="mt-4 inline-flex items-center gap-1.5 rounded-xl bg-(--forest) px-5 py-2.5 text-sm font-semibold text-white hover:bg-(--forest-mid) transition-colors">
            Find opportunities
          </a>
        </div>
      ) : (
        <div class="space-y-3">
          {volunteerActivity.map((va) => (
            <div class="flex items-center gap-4 rounded-xl border border-(--border) bg-white px-4 py-3 shadow-[var(--shadow)]">
              <!-- Status icon -->
              <div class:list={[
                'flex h-9 w-9 items-center justify-center rounded-full shrink-0 text-base font-bold',
                va.completed_at ? 'bg-green-50 text-green-700' : 'bg-(--cream) text-(--text-muted)'
              ]} aria-hidden="true">
                {va.completed_at ? '✓' : '↗'}
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-(--forest) truncate">{va.opp_title}</p>
                <p class="text-xs text-(--text-muted) truncate">
                  <a href={`/orgs/${va.org_slug}`} class="hover:text-(--forest) transition-colors">{va.org_name}</a>
                  {va.completed_at
                    ? <span class="ml-1.5 text-green-600 font-medium">· Completed {new Date(va.completed_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
                    : <span class="ml-1.5">· Clicked {new Date(va.clicked_at!).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
                  }
                </p>
              </div>

              <!-- Mark done button -->
              {!va.completed_at && (
                <button
                  class="mark-done-btn shrink-0 rounded-full border border-(--border) bg-white px-3 py-1.5 text-xs font-semibold text-(--forest-light) hover:border-(--leaf) hover:text-(--forest) transition-colors"
                  data-opp-id={va.opportunity_id}
                  data-org-id={va.org_id}
                >
                  Mark done
                </button>
              )}
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Reviews -->
    <section>
      <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Contributions</p>
        <h2 class="text-xl font-bold text-(--forest)">My Reviews</h2>
      </div>

      {reviews.length === 0 ? (
        <div class="rounded-2xl border border-(--border) bg-white px-6 py-12 text-center shadow-[var(--shadow)]">
          <p class="text-(--text-muted) text-sm leading-relaxed max-w-sm mx-auto">
            You haven't left any reviews yet. Share your honest volunteer experience to unlock badges and level up!
          </p>
          <a href="/search" class="mt-5 inline-flex items-center gap-1.5 rounded-xl bg-(--forest) px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-(--forest-mid) transition-colors">
            Find organizations
          </a>
        </div>
      ) : (
        <div class="space-y-4">
          {reviews.map((r) => (
            <div class="rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)]">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <a href={`/o/${r.org_slug}`} class="font-bold text-(--forest) hover:text-(--forest-light) transition-colors text-base">
                    {r.org_name}
                  </a>
                  <p class="mt-1 text-xs text-(--text-muted) font-medium">
                    <span class="text-amber-500 font-bold">{stars(r.rating)}</span> 
                    <span class="mx-1.5">•</span> 
                    Volunteered in {r.volunteered_in_year}
                  </p>
                </div>
                <span class:list={[
                  'rounded-full px-3 py-0.5 text-xs font-semibold uppercase tracking-wide',
                  r.status === 'published' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-yellow-50 text-yellow-700 border border-yellow-200'
                ]}>
                  {r.status === 'pending' ? 'Under review' : 'Published'}
                </span>
              </div>
              {r.body && <p class="mt-4 text-sm text-(--text-muted) leading-relaxed bg-(--cream)/30 p-4 rounded-xl border border-(--border)/40">{r.body}</p>}
              <p class="mt-3 text-[10px] text-(--text-muted) text-right">{new Date(r.created_at).toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Delete account -->
    <section id="delete-account" class="mt-14 rounded-2xl border border-red-200 bg-white p-6">
      <h2 class="text-lg font-bold text-red-800">Delete my account</h2>
      <p class="mt-2 text-sm text-(--text-muted) leading-relaxed max-w-xl">
        This permanently erases your name, email, sign-in methods, volunteer history and leaderboard spot, and takes down your reviews. It can't be undone.
      </p>
      {deleteError && (
        <p role="alert" class="mt-3 text-sm font-medium text-red-700">Type DELETE in the box to confirm.</p>
      )}
      <form method="post" class="mt-4 flex flex-wrap items-end gap-3">
        <input type="hidden" name="action" value="delete_account" />
        <label class="flex flex-col gap-1 text-sm text-(--forest)">
          Type <strong>DELETE</strong> to confirm
          <input
            name="confirm"
            autocomplete="off"
            required
            class="rounded-lg border border-(--border) px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-300"
          />
        </label>
        <button type="submit" class="rounded-lg bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800 transition-colors">
          Delete my account
        </button>
      </form>
    </section>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.mark-done-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const oppId = Number(btn.dataset.oppId);
      const orgId = Number(btn.dataset.orgId);
      btn.disabled = true;
      btn.textContent = '…';
      try {
        const res = await fetch('/api/volunteer/complete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ opportunityId: oppId, orgId }),
        });
        if (res.ok) {
          // Replace button with done badge and update icon
          const row = btn.closest('div.flex');
          if (row) {
            const icon = row.querySelector('.rounded-full.shrink-0');
            if (icon) { icon.textContent = '✓'; (icon as HTMLElement).className = 'flex h-9 w-9 items-center justify-center rounded-full shrink-0 text-base font-bold bg-green-50 text-green-700'; }
            const meta = row.querySelector('p.text-xs');
            if (meta) {
              const today = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
              const span = meta.querySelector('span:last-child');
              if (span) { span.textContent = `· Completed ${today}`; (span as HTMLElement).className = 'ml-1.5 text-green-600 font-medium'; }
            }
          }
          btn.remove();
        } else {
          btn.textContent = 'Try again';
          btn.disabled = false;
        }
      } catch {
        btn.textContent = 'Try again';
        btn.disabled = false;
      }
    });
  });
</script>
