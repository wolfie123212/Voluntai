---
import Base from '../layouts/Base.astro';
import { createAuth } from '../lib/auth';
import BadgeCard from '../components/BadgeCard.astro';
import QuestCard from '../components/QuestCard.astro';

const env = Astro.locals.runtime?.env;

if (!env) return Astro.redirect('/signin');

const auth = createAuth(env);
const session = await auth.api.getSession({ headers: Astro.request.headers });

if (!session?.user) return Astro.redirect('/signin?redirect=/account');

const user = session.user;

// Fetch user's published reviews
interface ReviewRow {
  id: number;
  org_id: number;
  org_name: string;
  org_slug: string;
  rating: number;
  body: string | null;
  volunteered_in_year: number;
  status: string;
  created_at: string;
}

let reviews: ReviewRow[] = [];
try {
  const result = await env.DB
    .prepare(`SELECT r.id, r.org_id, r.rating, r.body, r.volunteered_in_year, r.status, r.created_at,
                     o.name as org_name, o.slug as org_slug
              FROM reviews r
              JOIN organizations o ON o.id = r.org_id
              WHERE r.user_id = ? AND r.status IN ('published','pending')
              ORDER BY r.created_at DESC`)
    .bind(user.id)
    .all<ReviewRow>();
  reviews = result.results;
} catch { /* DB unavailable */ }

// Handle POST for display name update and sign out
let updateMsg = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');

  if (action === 'update_name') {
    const name = String(form.get('name') ?? '').trim();
    if (name) {
      await env.DB.prepare('UPDATE users SET display_name = ? WHERE id = ?').bind(name, user.id).run();
      updateMsg = 'Display name updated.';
      // Refresh the page to reflect display name changes
      return Astro.redirect('/account?updated=true');
    }
  }

  if (action === 'sign_out') {
    const authReq = new Request(`${env.APP_BASE_URL}/api/auth/sign-out`, {
      method: 'POST',
      headers: Astro.request.headers,
    });
    const authRes = await auth.handler(authReq);
    for (const [k, v] of authRes.headers.entries()) {
      if (k.toLowerCase() === 'set-cookie') Astro.response.headers.append('Set-Cookie', v);
    }
    return Astro.redirect('/');
  }
}

// Check for update URL param
const urlUpdated = new URL(Astro.request.url).searchParams.get('updated');
if (urlUpdated === 'true') {
  updateMsg = 'Display name updated successfully.';
}

function stars(n: number) { return '★'.repeat(n) + '☆'.repeat(5 - n); }

// MVP Gamification static data (custom tailored to their reviews count and local NYC theme)
const userLevel = reviews.length >= 3 ? 3 : reviews.length >= 1 ? 2 : 1;
const userXP = reviews.length * 150 + 50; // base + 150XP per review
const nextLevelXP = userLevel === 1 ? 200 : userLevel === 2 ? 500 : 1000;
const xpPercentage = Math.min(100, Math.round((userXP / nextLevelXP) * 100));

const BADGES = [
  { icon: '🌱', name: 'First Steps', desc: 'Create your account and complete registration.', earnedAt: user.createdAt },
  { icon: '⭐', name: 'Reviewer', desc: 'Leave your first review for a verified organization.', earnedAt: reviews.length >= 1 ? reviews[reviews.length - 1].created_at : undefined },
  { icon: '🍽️', name: 'Hunger Hero', desc: 'Complete 3 shifts at a local East Village food pantry.', earnedAt: reviews.some(r => r.org_slug.includes('mission') || r.org_slug.includes('cares')) ? user.createdAt : undefined },
  { icon: '🔥', name: 'On Fire', desc: 'Volunteer 3 times in a single calendar month.', earnedAt: undefined },
  { icon: '🏆', name: 'Community Leader', desc: 'Reach volunteer Level 5 with 1,500+ XP.', earnedAt: undefined },
];

const QUESTS = [
  { title: 'East Village Explorer', description: 'Explore and volunteer at 2 different organizations in 10003 or 10009 ZIP codes.', category: 'Discovery', progress: Math.min(2, reviews.length), target: 2, xpReward: 250 },
  { title: 'Food & Hunger Champion', description: 'Complete and review 3 food bank or food rescue sessions.', category: 'Food Pantry', progress: reviews.some(r => r.org_slug.includes('mission')) ? 1 : 0, target: 3, xpReward: 400 },
  { title: 'Trusted Voice', description: 'Write 3 helpful community reviews to earn this badge.', category: 'Community', progress: Math.min(3, reviews.length), target: 3, xpReward: 150 },
];
---

<Base title="My Account">
  <div class="mx-auto max-w-6xl px-4 py-12">
    
    <!-- Profile & Gamification Header Grid -->
    <div class="grid gap-6 md:grid-cols-3 mb-10">
      
      <!-- Profile Box -->
      <div class="md:col-span-2 rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)] flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-4 mb-6">
            <!-- Avatar mockup -->
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-(--forest) text-white font-extrabold text-2xl shadow-md border border-white">
              {((user as unknown as { displayName?: string }).displayName ?? user.name ?? 'U').charAt(0).toUpperCase()}
            </div>
            <div>
              <h1 class="text-xl font-bold text-(--forest)">
                {(user as unknown as { displayName?: string }).displayName ?? user.name ?? 'Volunteer User'}
              </h1>
              <p class="text-xs text-(--text-muted)">{user.email}</p>
              <div class="mt-2 flex items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-(--cream) px-2.5 py-0.5 text-[10px] font-semibold text-(--forest-light)">
                  🛡️ Role: {user.role || 'Volunteer'}
                </span>
                <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-0.5 text-[10px] font-semibold text-amber-700 border border-amber-200">
                  ⚡ Level {userLevel} Volunteer
                </span>
              </div>
            </div>
          </div>

          <!-- XP Bar -->
          <div class="space-y-2 mb-6">
            <div class="flex justify-between text-xs font-semibold">
              <span class="text-(--forest)">XP Progress</span>
              <span class="text-(--text-muted)">{userXP} / {nextLevelXP} XP</span>
            </div>
            <div class="h-3 w-full rounded-full bg-(--cream-dark) overflow-hidden shadow-inner">
              <div 
                class="h-full rounded-full bg-gradient-to-r from-(--leaf) to-(--forest-light) transition-all duration-500 ease-out" 
                style={`width: ${xpPercentage}%`}
              ></div>
            </div>
          </div>
        </div>

        {updateMsg && (
          <p class="mb-4 rounded-xl bg-green-50 border border-green-200 px-4 py-2.5 text-sm text-green-800" role="status">
            {updateMsg}
          </p>
        )}

        <!-- Edit Profile Name Form -->
        <form method="post" class="flex gap-3">
          <input type="hidden" name="action" value="update_name" />
          <input
            name="name"
            type="text"
            required
            defaultValue={(user as unknown as { displayName?: string }).displayName ?? (user as any).name ?? ''}
            placeholder="Edit display name"
            class="flex-1 rounded-xl border border-(--border) bg-(--cream) px-4 py-2 text-sm text-(--forest) placeholder-(--text-muted)/60 focus:border-(--leaf) focus:outline-none transition-all"
          />
          <button type="submit" class="rounded-xl bg-(--forest) px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-(--forest-mid) transition-colors">
            Update Name
          </button>
        </form>
      </div>

      <!-- Sign Out / Actions Panel -->
      <div class="rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)] flex flex-col justify-between">
        <div>
          <h2 class="font-bold text-(--forest) mb-3">Volunteer Stats</h2>
          <div class="grid grid-cols-2 gap-3 text-center mb-6">
            <div class="rounded-xl bg-(--cream) p-3 shadow-inner">
              <p class="text-2xl font-black text-(--forest)">{reviews.length}</p>
              <p class="text-[10px] font-semibold text-(--text-muted) uppercase tracking-wider mt-0.5">Reviews</p>
            </div>
            <div class="rounded-xl bg-(--cream) p-3 shadow-inner">
              <p class="text-2xl font-black text-(--forest)">{userXP}</p>
              <p class="text-[10px] font-semibold text-(--text-muted) uppercase tracking-wider mt-0.5">Total XP</p>
            </div>
          </div>
        </div>

        <form method="post" class="w-full">
          <input type="hidden" name="action" value="sign_out" />
          <button type="submit" class="w-full rounded-xl border border-red-200 py-3 text-sm font-semibold text-red-600 hover:bg-red-50 hover:border-red-300 transition-colors">
            Sign out
          </button>
        </form>
      </div>
    </div>

    <!-- Active Quests -->
    <section class="mb-10">
      <div class="mb-6 flex items-end justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Challenges</p>
          <h2 class="text-xl font-bold text-(--forest)">Active Quests</h2>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {QUESTS.map((quest) => (
          <QuestCard {...quest} />
        ))}
      </div>
    </section>

    <!-- Badges Grid -->
    <section class="mb-10">
      <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Achievements</p>
        <h2 class="text-xl font-bold text-(--forest)">Volunteer Badges</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {BADGES.map((badge) => (
          <BadgeCard {...badge} />
        ))}
      </div>
    </section>

    <!-- Reviews -->
    <section>
      <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Contributions</p>
        <h2 class="text-xl font-bold text-(--forest)">My Reviews</h2>
      </div>

      {reviews.length === 0 ? (
        <div class="rounded-2xl border border-(--border) bg-white px-6 py-12 text-center shadow-[var(--shadow)]">
          <div class="mx-auto mb-4 text-4xl" aria-hidden="true">✍️</div>
          <p class="text-(--text-muted) text-sm leading-relaxed max-w-sm mx-auto">
            You haven't left any reviews yet. Share your honest volunteer experience to unlock badges and level up!
          </p>
          <a href="/search" class="mt-5 inline-flex items-center gap-1.5 rounded-xl bg-(--forest) px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-(--forest-mid) transition-colors">
            Find organizations
          </a>
        </div>
      ) : (
        <div class="space-y-4">
          {reviews.map((r) => (
            <div class="rounded-2xl border border-(--border) bg-white p-6 shadow-[var(--shadow)]">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <a href={`/o/${r.org_slug}`} class="font-bold text-(--forest) hover:text-(--forest-light) transition-colors text-base">
                    {r.org_name}
                  </a>
                  <p class="mt-1 text-xs text-(--text-muted) font-medium">
                    <span class="text-amber-500 font-bold">{stars(r.rating)}</span> 
                    <span class="mx-1.5">•</span> 
                    Volunteered in {r.volunteered_in_year}
                  </p>
                </div>
                <span class:list={[
                  'rounded-full px-3 py-0.5 text-xs font-semibold uppercase tracking-wide',
                  r.status === 'published' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-yellow-50 text-yellow-700 border border-yellow-200'
                ]}>
                  {r.status === 'pending' ? 'Under review' : 'Published'}
                </span>
              </div>
              {r.body && <p class="mt-4 text-sm text-(--text-muted) leading-relaxed bg-(--cream)/30 p-4 rounded-xl border border-(--border)/40">{r.body}</p>}
              <p class="mt-3 text-[10px] text-(--text-muted) text-right">{new Date(r.created_at).toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            </div>
          ))}
        </div>
      )}
    </section>
  </div>
</Base>
