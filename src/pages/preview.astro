---
import HeroA from '../components/HeroA.astro';
import HeroB from '../components/HeroB.astro';
import HeroC from '../components/HeroC.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>CityServ — Hero Preview</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Inter, system-ui, sans-serif; background: #111; color: white; }
    .label {
      padding: 16px 24px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #aaa;
      background: #111;
    }
    .option { position: relative; }
    .hero-wrap {
      position: relative;
      height: 560px;
      overflow: hidden;
    }
    .hero-wrap svg { position: absolute; inset: 0; width: 100%; height: 100%; }
    .overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 24px;
    }
    .tag {
      display: inline-block;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 999px;
      padding: 6px 18px;
      font-size: 13px;
      font-weight: 500;
      color: white;
      margin-bottom: 20px;
    }
    h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 800;
      color: white;
      text-shadow: 0 2px 20px rgba(0,0,0,0.4);
      line-height: 1.1;
      margin-bottom: 16px;
    }
    .subtitle {
      font-size: 1.1rem;
      color: rgba(255,255,255,0.85);
      text-shadow: 0 1px 8px rgba(0,0,0,0.4);
      margin-bottom: 32px;
      max-width: 480px;
    }
    .search-mock {
      display: flex;
      gap: 8px;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 999px;
      padding: 8px 8px 8px 20px;
      width: 100%;
      max-width: 440px;
      align-items: center;
    }
    .search-mock span {
      flex: 1;
      font-size: 15px;
      color: rgba(255,255,255,0.6);
    }
    .search-mock button {
      background: white;
      color: #1a2e1a;
      border: none;
      border-radius: 999px;
      padding: 10px 22px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }
    .badge {
      position: absolute;
      top: 20px;
      left: 20px;
      background: rgba(0,0,0,0.5);
      backdrop-filter: blur(8px);
      color: white;
      font-size: 12px;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.2);
    }
    .divider { height: 24px; background: #111; }
  </style>
</head>
<body>
  <div style="background:#111; padding: 32px 24px 16px; text-align:center;">
    <p style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#555;margin-bottom:8px">CityServ — Hero Illustration Preview</p>
    <p style="color:#888; font-size:14px">Three options — same scene (trees + city), different moods. Pick your favourite.</p>
  </div>

  <!-- Option A -->
  <div class="option">
    <div class="label">Option A — Golden Hour &nbsp;·&nbsp; Warm amber sunset, rich greens</div>
    <div class="hero-wrap">
      <HeroA />
      <div class="overlay">
        <span class="tag">🌿 East Village · Lower East Side</span>
        <h1>Serve your city.<br/>Find your cause.</h1>
        <p class="subtitle">Verified volunteer opportunities in NYC's East Village — trusted, real, and ready for you.</p>
        <div class="search-mock">
          <span>Search opportunities…</span>
          <button>Find →</button>
        </div>
      </div>
      <span class="badge">A — Golden Hour</span>
    </div>
  </div>

  <div class="divider"></div>

  <!-- Option B -->
  <div class="option">
    <div class="label">Option B — Morning Fresh &nbsp;·&nbsp; Bright blue sky, vivid spring greens</div>
    <div class="hero-wrap">
      <HeroB />
      <div class="overlay">
        <span class="tag">🌿 East Village · Lower East Side</span>
        <h1>Serve your city.<br/>Find your cause.</h1>
        <p class="subtitle">Verified volunteer opportunities in NYC's East Village — trusted, real, and ready for you.</p>
        <div class="search-mock">
          <span>Search opportunities…</span>
          <button>Find →</button>
        </div>
      </div>
      <span class="badge">B — Morning Fresh</span>
    </div>
  </div>

  <div class="divider"></div>

  <!-- Option C -->
  <div class="option">
    <div class="label">Option C — Dusk / Twilight &nbsp;·&nbsp; Purple-amber sky, city lights, dramatic</div>
    <div class="hero-wrap">
      <HeroC />
      <div class="overlay">
        <span class="tag">🌿 East Village · Lower East Side</span>
        <h1>Serve your city.<br/>Find your cause.</h1>
        <p class="subtitle">Verified volunteer opportunities in NYC's East Village — trusted, real, and ready for you.</p>
        <div class="search-mock">
          <span>Search opportunities…</span>
          <button>Find →</button>
        </div>
      </div>
      <span class="badge">C — Dusk</span>
    </div>
  </div>

  <div style="padding:32px 24px; text-align:center; color:#555; font-size:13px;">
    Tell me which one you like (A, B, or C) and I'll build the full site around it.
  </div>
</body>
</html>
