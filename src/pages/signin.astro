---
import Base from '../layouts/Base.astro';
import { createAuth } from '../lib/auth';

const env = Astro.locals.runtime?.env;
let error = '';

// Redirect if already signed in
if (env) {
  const auth = createAuth(env);
  const session = await auth.api.getSession({ headers: Astro.request.headers });
  if (session?.user) return Astro.redirect('/account');
}

const redirectTo = new URL(Astro.request.url).searchParams.get('redirect') ?? '/account';

if (Astro.request.method === 'POST' && env) {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim().toLowerCase();
  const password = String(form.get('password') ?? '');

  if (!email || !password) {
    error = 'Email and password are required.';
  } else {
    const auth = createAuth(env);
    const authReq = new Request(`${env.APP_BASE_URL}/api/auth/sign-in/email`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });

    const authRes = await auth.handler(authReq);

    if (authRes.ok) {
      // Proxy Set-Cookie headers
      for (const [k, v] of authRes.headers.entries()) {
        if (k.toLowerCase() === 'set-cookie') {
          Astro.response.headers.append('Set-Cookie', v);
        }
      }
      return Astro.redirect(redirectTo);
    } else {
      const body = await authRes.json() as { message?: string };
      error = body.message ?? 'Invalid email or password.';
    }
  }
}
---

<Base title="Sign In">
  <div class="mx-auto max-w-md px-4 py-16">
    <div class="rounded-2xl border border-green-800/50 bg-green-900/30 p-8">
      <h1 class="mb-2 text-2xl font-bold text-white">Sign in</h1>
      <p class="mb-8 text-sm text-green-400">New here? <a href="/signup" class="text-green-300 underline underline-offset-2 hover:text-white">Create an account</a></p>

      {error && (
        <div class="mb-6 rounded-xl border border-red-800/50 bg-red-900/30 px-4 py-3 text-sm text-red-300" role="alert" aria-live="polite">
          {error}
        </div>
      )}

      <form method="post" class="space-y-4" novalidate>
        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium text-green-300">Email</label>
          <input
            id="email" name="email" type="email" required autocomplete="email"
            class="w-full rounded-xl border border-green-700 bg-green-900/50 px-4 py-2.5 text-white placeholder-green-600 focus:border-green-500 focus:outline-none"
            placeholder="you@example.com"
          />
        </div>
        <div>
          <label for="password" class="mb-1.5 block text-sm font-medium text-green-300">Password</label>
          <input
            id="password" name="password" type="password" required autocomplete="current-password"
            class="w-full rounded-xl border border-green-700 bg-green-900/50 px-4 py-2.5 text-white placeholder-green-600 focus:border-green-500 focus:outline-none"
            placeholder="••••••••"
          />
        </div>

        <button type="submit" class="w-full rounded-xl bg-green-500 py-3 font-semibold text-green-950 hover:bg-green-400 transition-colors">
          Sign in
        </button>
      </form>

      <div class="my-6 flex items-center gap-3">
        <div class="flex-1 border-t border-green-800"></div>
        <span class="text-xs text-green-600">or</span>
        <div class="flex-1 border-t border-green-800"></div>
      </div>

      <a
        href="/api/auth/sign-in/social?provider=google"
        class="flex w-full items-center justify-center gap-3 rounded-xl border border-green-700 bg-green-900/30 py-3 text-sm font-medium text-white hover:bg-green-900/60 transition-colors"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Continue with Google
      </a>

      <p class="mt-6 text-center text-xs text-green-600">
        <a href="/api/auth/forget-password" class="hover:text-green-400 transition-colors">Forgot your password?</a>
      </p>
    </div>
  </div>
</Base>
