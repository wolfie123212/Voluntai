---
import Base from '../../layouts/Base.astro';
import { createAuth } from '../../lib/auth';
import { getCityStats } from '../../lib/db/visits';

const ADMIN_EMAIL = 'wolfbusterwhite@gmail.com';
const env = Astro.locals.runtime?.env;

if (!env) return Astro.redirect('/signin');

const cfEmail = Astro.request.headers.get('Cf-Access-Authenticated-User-Email');
let adminEmail = cfEmail === ADMIN_EMAIL ? cfEmail : null;
if (!adminEmail) {
  const auth = createAuth(env);
  const session = await auth.api.getSession({ headers: Astro.request.headers });
  if (session?.user?.email === ADMIN_EMAIL) adminEmail = session.user.email;
}
if (!adminEmail) return Astro.redirect('/');

const RANGES = [7, 30, 90] as const;
const reqDays = Number(Astro.url.searchParams.get('days'));
const days = (RANGES as readonly number[]).includes(reqDays) ? reqDays : 30;

const stats = await getCityStats(env.DB, days);
const maxViews = Math.max(1, ...stats.cities.map((c) => c.views));
const maxDay = Math.max(1, ...stats.daily.map((d) => d.views));
const nycViews = stats.cities
  .filter((c) => c.country === 'US' && c.region === 'New York' && /new york|brooklyn|queens|bronx|staten island|manhattan/i.test(c.city))
  .reduce((n, c) => n + c.views, 0);
const nycPct = stats.totals.views ? Math.round((nycViews / stats.totals.views) * 100) : 0;
---

<Base title="City Analytics">
  <div class="mx-auto max-w-4xl px-4 py-10">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-(--text-muted) mb-1">Admin</p>
        <h1 class="text-2xl font-bold text-(--forest)">Where visitors are coming from</h1>
        <p class="text-sm text-(--text-muted) mt-1">Daily totals by city since {stats.since}. No IP addresses are stored.</p>
      </div>
      <div class="flex rounded-lg border border-(--border) overflow-hidden text-sm font-medium" role="group" aria-label="Date range">
        {RANGES.map((r, i) => (
          <a
            href={`/admin/analytics?days=${r}`}
            aria-current={r === days ? 'page' : undefined}
            class:list={[
              'px-4 py-2 transition-colors',
              i > 0 && 'border-l border-(--border)',
              r === days ? 'bg-(--forest) text-white' : 'bg-white text-(--forest-light) hover:bg-(--cream)',
            ]}
          >{r}d</a>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
      {[
        { n: stats.totals.views.toLocaleString(), l: 'page views' },
        { n: stats.totals.signins.toLocaleString(), l: 'sign-ins' },
        { n: stats.totals.cities.toLocaleString(), l: 'distinct cities' },
        { n: `${nycPct}%`, l: 'of views from NYC' },
      ].map((k) => (
        <div class="rounded-xl border border-(--border) bg-white p-4">
          <p class="text-2xl font-bold text-(--forest) tabular-nums">{k.n}</p>
          <p class="text-xs text-(--text-muted) mt-1">{k.l}</p>
        </div>
      ))}
    </div>

    <section class="rounded-xl border border-(--border) bg-white p-5 mb-6" aria-label="Views per day">
      <h2 class="text-sm font-semibold text-(--forest) mb-4">Views per day</h2>
      {stats.daily.length === 0 ? (
        <p class="text-sm text-(--text-muted)">No visits recorded yet. Counting started with this release.</p>
      ) : (
        <div class="flex items-end gap-1 h-32">
          {stats.daily.map((d) => (
            <div class="flex-1 h-full flex flex-col justify-end" title={`${d.day}: ${d.views} views, ${d.signins} sign-ins`}>
              <div class="rounded-t bg-(--leaf)" style={`height:${Math.max(2, (d.views / maxDay) * 100)}%`}></div>
            </div>
          ))}
        </div>
      )}
    </section>

    <section class="rounded-xl border border-(--border) bg-white overflow-hidden" aria-label="Top cities">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[520px]">
          <thead class="bg-(--cream) text-left text-xs uppercase tracking-wider text-(--text-muted)">
            <tr>
              <th scope="col" class="px-5 py-3 font-semibold">City</th>
              <th scope="col" class="px-5 py-3 font-semibold">Region</th>
              <th scope="col" class="px-5 py-3 font-semibold w-1/3">Views</th>
              <th scope="col" class="px-5 py-3 font-semibold text-right">Sign-ins</th>
            </tr>
          </thead>
          <tbody>
            {stats.cities.length === 0 && (
              <tr><td colspan="4" class="px-5 py-8 text-center text-(--text-muted)">No data yet.</td></tr>
            )}
            {stats.cities.map((c) => (
              <tr class="border-t border-(--border)">
                <td class="px-5 py-3 font-medium text-(--forest)">{c.city}</td>
                <td class="px-5 py-3 text-(--text-muted)">{c.region}, {c.country}</td>
                <td class="px-5 py-3">
                  <div class="flex items-center gap-3">
                    <div class="h-1.5 flex-1 rounded-full bg-(--border) overflow-hidden">
                      <div class="h-full bg-(--leaf)" style={`width:${(c.views / maxViews) * 100}%`}></div>
                    </div>
                    <span class="w-10 text-right tabular-nums text-(--forest)">{c.views}</span>
                  </div>
                </td>
                <td class="px-5 py-3 text-right tabular-nums text-(--forest)">{c.signins}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="mt-4 text-xs text-(--text-muted)">
      City comes from Cloudflare's network location and can be off for phones and VPNs (often shows a nearby hub city). Bots and scanners are excluded.
    </p>
  </div>
</Base>
