{
  "name": "cityserv",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply service-finder-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply service-finder-db --remote",
    "seed": "npx tsx scripts/seed-east-village.ts",
    "fix:opps": "npx tsx scripts/fix-opportunities.ts",
    "refresh": "npx tsx scripts/refresh-verifications.ts",
    "import:bmf": "npx tsx scripts/import-irs-bmf.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "astro": "^5.0.0",
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.0",
    "resend": "^6.12.3",
    "tailwindcss": "^4.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.0.0",
    "tsx": "latest",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
